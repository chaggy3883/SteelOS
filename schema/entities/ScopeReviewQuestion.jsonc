{
  "name": "ScopeReviewQuestion",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "question_text": {
      "type": "string"
    },
    "answer_text": {
      "type": "string",
      "description": "Empty/unset until a response comes back from the customer — ScopeReviewPanel.jsx's unanswered-count indicator is just a count of rows where this is blank."
    },
    "raised_by": {
      "type": "string",
      "description": "user.full_name || user.email, captured when the question is added."
    },
    "raised_date": {
      "type": "string"
    },
    "answered_date": {
      "type": "string",
      "description": "Stamped the first time answer_text goes from empty to non-empty."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "project_id",
    "question_text"
  ]
}
