{
  "name": "CustomRole",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant this custom role belongs to. Added retroactively — CustomRole previously had no tenant concept at all, so any admin from any company could see and assign every other company's custom roles. Now in TENANT_SCOPED_ENTITIES (src/api/localData.js) like every other company-owned config entity; a one-time migrateCustomRoleCompanyId() backfill assigns pre-existing rows to 'company-hancock' since no other field can identify which tenant created them."
    },
    "role_name": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "allowed_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_widgets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "granular_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fine-grained action/tab permission keys from permissionCatalog.js's GRANULAR_PERMISSION_CATALOG (e.g. 'tab:/human-resources:timeoff', 'action:hr.employee.terminate') — an ADDITIONAL layer on top of allowed_modules, not a replacement. allowed_modules/allowed_widgets still gate whether this role can reach a page at all; granular_permissions narrows what it can specifically DO once there (e.g. approve PTO but not terminate employees). Only a subset of these keys have live enforcement so far — see canManageDisciplinaryActions (disciplinaryAccess.js), TerminationPanel.jsx, and HumanResources.jsx's PTO approval tab."
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "role_name",
    "label"
  ]
}