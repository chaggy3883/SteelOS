{
  "name": "TaxRate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "street_address": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "tax_percentage": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "When this rate takes effect. Defaults to the row's creation date if not set. A new rate created for a ZIP/address that already has an active row ends the old row (end_date/is_active) rather than overwriting it, so a bid calculated under the old rate can still be traced back to it."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "When this rate was superseded by a newer row for the same ZIP/address. Null while the row is the current active rate."
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "avatax",
        "vertex"
      ],
      "default": "manual"
    },
    "last_api_sync": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "zip_code",
    "state",
    "tax_percentage"
  ]
}