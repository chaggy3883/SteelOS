{
  "name": "issued_assets",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "Hard_Hat",
        "Safety_Glasses",
        "Prescription_Safety_Glasses",
        "Harness",
        "Gloves",
        "Steel_Toe_Boots",
        "Radio",
        "Badge",
        "Keys",
        "Laptop",
        "Phone",
        "Other"
      ]
    },
    "asset_tag": {
      "type": "string"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "returned_date": {
      "type": "string",
      "format": "date",
      "description": "Empty/absent = not yet returned. Every 'outstanding equipment' check in the app (TerminationPanel's offboarding checklist, EquipmentPanel) keys off this being blank."
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Good",
        "Worn",
        "Damaged",
        "Lost"
      ],
      "default": "New",
      "description": "Condition at issuance (New/Good/Worn/Damaged) until returned_date is set, then overwritten with the condition assessed on return (Good/Damaged/Lost) — see RETURN_CONDITIONS in src/lib/issuedAssetsApi.js."
    },
    "notes": {
      "type": "string",
      "description": "Free text — e.g. \"screen is cracked\", \"keys never found\". The audit trail for missing/damaged equipment."
    }
  },
  "required": [
    "employee_id",
    "asset_type"
  ]
}
