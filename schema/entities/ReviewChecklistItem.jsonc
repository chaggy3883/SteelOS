{
  "name": "ReviewChecklistItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "item_code": {
      "type": "string",
      "description": "Short unique identifier like 'INS-1', used as contract_exception_lines.provision_number_tag."
    },
    "category": {
      "type": "string",
      "enum": [
        "General/Commercial",
        "Division 05",
        "Quality/Safety"
      ]
    },
    "item_label": {
      "type": "string",
      "description": "Human-readable name shown in review results."
    },
    "keywords": {
      "type": "string",
      "description": "Comma-separated keyword phrases searched for, case-insensitive substring match."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "note_for_estimator": {
      "type": "string",
      "description": "Optional guidance shown when this item is found or not found."
    },
    "requires_value_extraction": {
      "type": "boolean",
      "default": false,
      "description": "True for items like EDGE % where a number needs to be pulled out near the matched keyword."
    },
    "is_required": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "item_label",
    "keywords"
  ]
}
