{
  "name": "PayrollAdjustment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "payroll_run_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "adjustment_type": {
      "type": "string",
      "enum": ["bonus", "deduction", "reimbursement", "correction", "commission", "other"],
      "description": "'deduction' is stored as a negative amount (see checkNegativeOrManualAdjustments in payrollControls.js, which already flags any negative amount for review) and reduces total_net only, not total_gross — it's a post-tax reduction, not a reduction of gross wages."
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "reason": {
      "type": "string",
      "description": "Mandatory for a manually-entered bonus/deduction (enforced in PayrollRunPanel.jsx) — no silent adjustments."
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "payroll_run_id",
    "employee_id",
    "adjustment_type",
    "amount",
    "reason"
  ]
}
