{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "success",
        "review_assigned",
        "rfi_update",
        "document_update",
        "approval_required",
        "co_update",
        "bulletin_issued"
      ]
    },
    "project_id": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_date": {
      "type": "string",
      "format": "date-time"
    },
    "entity_type": {
      "type": "string",
      "enum": ["RFI", "ChangeOrder", "ProjectBulletin", "AchIncoming"],
      "description": "Set alongside entity_id for the RFI/CO/Addenda notification routing system (src/lib/salesNotifications.js) — blank for other notification types that predate it. 'AchIncoming' is used by src/lib/achEngine.js's notifyArUnmatchedAch, broadcast to every user holding an AR-relevant role (finance_department/controller/president/ceo) rather than a project-scoped assignee."
    },
    "entity_id": {
      "type": "string",
      "description": "Id of the RFI/change_orders/ProjectBulletin/AchIncoming row this notification is about."
    },
    "creator_id": {
      "type": "string",
      "description": "employees.id of whoever created/changed the linked entity, for display (\"{Creator} created RFI #...\")."
    }
  },
  "required": [
    "user_id",
    "title",
    "message",
    "type"
  ],
  "name": "Notification"
}