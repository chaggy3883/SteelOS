{
  "name": "TurnoverMeetingRecord",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "completed"],
      "default": "draft",
      "description": "Once 'completed', TurnoverReviewPanel.jsx renders the form read-only — this is operational/logistics handoff reference material, not a living document. No pricing/cost data from the Bid Worksheet appears here."
    },
    "checklist_list": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "detail": { "type": "string", "description": "'tons' = asks for galvanizing_tons once checked." }
        }
      },
      "default": null,
      "description": "This project's own checklist (edited on the Project Handoff tab: renamed, reordered, removed or added items). null = the standard list (DEFAULT_CHECKLIST in turnoverReviewShared.js)."
    },
    "checklist_items": {
      "type": "object",
      "default": {},
      "description": "Yes/no answers, keyed by checklist item key (booleans). Standard keys: specs_plans_received, addendums_received, plans_specs_sent_to_vendors, vendor_quotes_saved, estimator_notes_attached, scope_of_work_attached, engineering_required, joist_deck_required, tc_bolt_required, fire_proofing_required, beams_with_camber, galvanizing_required; added items use custom_* keys."
    },
    "galvanizing_tons": {
      "type": "number",
      "description": "Only meaningful when checklist_items.galvanizing_required is true."
    },
    "scope_vendors": {
      "type": "object",
      "default": {},
      "description": "Who the job is using per outside scope, keyed detailing / erection / joist_deck / miscellaneous / rolling / steel_material: { vendor_name, quotes: [{ kind: 'document', id, name } | { kind: 'link', id, url, name }] }. Quotes point at the won estimate's own Document (bid_id) or VendorPricingLink cost sheet — referenced, never copied."
    },
    "detailing_company": {
      "type": "string",
      "description": "Legacy (before scope_vendors): carried into scope_vendors.detailing when a record is loaded."
    },
    "pricing_basis": {
      "type": "string",
      "description": "Legacy — no longer shown on the handoff (pricing basis lives on the estimate)."
    },
    "erector_name": {
      "type": "string",
      "description": "Legacy (before scope_vendors): carried into scope_vendors.erection when a record is loaded."
    },
    "sub_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "default": [],
      "description": "Repeatable list of every sub quote received for the job — company + quote type (e.g. erection, hauling, misc.)."
    },
    "special_materials": {
      "type": "string",
      "description": "Special/unusual materials required."
    },
    "special_shipping_instructions": {
      "type": "string"
    },
    "surface_prep_instructions": {
      "type": "string",
      "description": "Surface preparation / primer / finish paint instructions."
    },
    "lintels_notes": {
      "type": "string"
    },
    "embeds_notes": {
      "type": "string"
    },
    "sequencing_notes": {
      "type": "string"
    },
    "required_attendees": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Pre-populated from Company.turnover_meeting_standard_attendees when this record is first created for a project; editable per project from there on."
    },
    "actual_attendees": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "completed_by": {
      "type": "string",
      "description": "user.full_name || user.email, captured when status is set to 'completed'."
    },
    "completed_date": {
      "type": "string",
      "description": "ISO date stamped when status flips to 'completed'."
    }
  },
  "required": [
    "project_id"
  ]
}
