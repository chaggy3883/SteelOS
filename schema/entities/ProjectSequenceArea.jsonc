{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string",
      "description": "Set when this Area is created during estimating, before a bid is won. Exactly one of bid_id/project_id is expected before win; createProjectFromWonBid (BidDetail.jsx) sets project_id on this same record on win, so both are set afterward — it is never recreated as a new record."
    },
    "project_id": {
      "type": "string",
      "description": "Populated when a bid carrying this Area is won (createProjectFromWonBid in BidDetail.jsx). Null for a bid-stage Area not yet won."
    },
    "name": {
      "type": "string",
      "description": "e.g. 'Sequence 1', 'Area A - North Wing'."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "contract_value_pct": {
      "type": "number",
      "default": 0,
      "description": "% of the bid's total contract value this Area represents (0-100). Worked out from the Full Takeoff (this Area's tons ÷ the tons in all Areas, src/lib/areaBreakdown.js) each time the takeoff is saved, unless pct_source is 'manual'. Drives SovLine.original_scheduled_value on bid win. Never shown to shop/production roles — see src/lib/areaVisibility.js."
    },
    "pct_source": {
      "type": "string",
      "enum": ["takeoff", "manual"],
      "description": "'takeoff' = contract_value_pct follows the Full Takeoff automatically; 'manual' = typed by the estimator and left alone. Missing on Areas saved before this existed: a nonzero % is treated as manual, 0% as takeoff (areaFollowsTakeoff)."
    },
    "production_priority": {
      "type": "number",
      "default": 0,
      "description": "Explicit, freely user-reorderable shop production sequence (lower = worked first). Distinct from sort_order, which ProjectManagement.jsx's Shop Drawing grouping already uses for an unrelated display order."
    }
  },
  "required": [
    "name"
  ],
  "name": "ProjectSequenceArea"
}
