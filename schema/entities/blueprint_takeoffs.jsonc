{
  "name": "blueprint_takeoffs",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "takeoff_name": {
      "type": "string"
    },
    "last_opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "has_stored_pdf": {
      "type": "boolean",
      "default": false
    },
    "sheet_count": {
      "type": "number",
      "default": 1
    },
    "scale_reference": {
      "type": "string"
    },
    "px_per_ft": {
      "type": "number"
    },
    "calibration_unit": {
      "type": "string",
      "enum": ["ft", "in"]
    },
    "tool_chest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tool": { "type": "string", "enum": ["count", "length", "area"] },
          "label": { "type": "string" },
          "shapeClass": { "type": "string" },
          "sizeDesignation": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    },
    "accepted_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_number": {
            "type": "number",
            "default": 1
          },
          "shape_type": {
            "type": "string"
          },
          "size_designation": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": { "type": "number" }
          },
          "confidence": {
            "type": "number"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_weight_lbs_per_ft": {
            "type": "number",
            "default": 0
          },
          "length_ft": {
            "type": "number",
            "default": 0
          },
          "unit_cost_cents": {
            "type": "number",
            "default": 0
          },
          "is_accepted": {
            "type": "boolean",
            "default": true
          },
          "notes": {
            "type": "string"
          },
          "is_demo": {
            "type": "boolean",
            "default": false
          },
          "source": {
            "type": "string",
            "enum": ["measurement"]
          },
          "tool": {
            "type": "string",
            "enum": ["count", "length", "area"]
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "pdfX": {
            "type": "number"
          },
          "pdfY": {
            "type": "number"
          },
          "point1": {
            "type": "object",
            "properties": {
              "pdfX": { "type": "number" },
              "pdfY": { "type": "number" }
            }
          },
          "point2": {
            "type": "object",
            "properties": {
              "pdfX": { "type": "number" },
              "pdfY": { "type": "number" }
            }
          },
          "polygon_points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pdfX": { "type": "number" },
                "pdfY": { "type": "number" }
              }
            }
          },
          "area_sq_ft": {
            "type": "number"
          },
          "pushed_to_estimate": {
            "type": "boolean",
            "default": false,
            "description": "Set once this row's markup group has been pushed to a MaterialTakeoffLine record — drives the green checkmark / Re-push state in the Markups List."
          },
          "pushed_material_line_id": {
            "type": "string",
            "description": "id of the MaterialTakeoffLine record this row's markup group was pushed to. Re-pushing updates this record instead of creating a duplicate."
          }
        }
      }
    },
    "total_cost_cents": {
      "type": "number",
      "default": 0
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "file_url"
  ]
}
