{
  "name": "blueprint_takeoffs",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string"
    },
    "sequence_area_id": {
      "type": "string",
      "description": "Nullable FK to ProjectSequenceArea — which of the bid's own Areas (BidAreaManager.jsx) this takeoff session is for, picked optionally at drop time (BlueprintTakeoff.jsx's bid-entry drop-first panel). Null/unset means no area was picked, or the bid has none defined. Carried onto every MaterialTakeoffLine pushed from this session (MaterialTakeoffLine.sequence_area_id) via MarkupsList.jsx's buildPayload."
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "takeoff_name": {
      "type": "string"
    },
    "last_opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "has_stored_pdf": {
      "type": "boolean",
      "default": false
    },
    "sheet_count": {
      "type": "number",
      "default": 1
    },
    "scale_reference": {
      "type": "string"
    },
    "px_per_ft": {
      "type": "number",
      "description": "LEGACY — the single whole-set scale from before per-page scale existed: PDF points (IRONSIGHT PDF space at zoom 1, 72 per inch) per real foot. Still read on load as the fallback for any page with no page_scales entry, so older sessions measure exactly as before (src/lib/takeoffScale.js migrateScaleState/resolveScaleAt). No longer written."
    },
    "page_scales": {
      "type": "object",
      "description": "Drawing scale per PDF page, keyed by page number (\"1\", \"2\", …). A measurement uses the viewport containing its first click, else the page scale, else legacy px_per_ft; with none of those the page is blocked from measuring. Written by useTakeoffScales.js right after every change (ScalePanel.jsx).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "pts_per_ft": { "type": "number", "description": "PDF points of paper per real foot. 1/8\" = 1'-0\" -> 9; 1\" = 10' -> 7.2; 1:100 -> 8.64 (864/N)." },
          "label": { "type": "string", "description": "Readable scale, e.g. 1/8\" = 1'-0\"." },
          "source": { "type": "string", "enum": ["preset", "calibrated"] },
          "preset_id": { "type": "string", "description": "takeoffScale.js SCALE_PRESETS id when source is preset." },
          "viewports": {
            "type": "array",
            "description": "Rectangular areas of this page drawn at a different scale (a detail). x1/y1/x2/y2 are PDF-space corners (x1<x2, y1<y2). A viewport with no pts_per_ft blocks measuring inside it rather than falling back to the page scale.",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "x1": { "type": "number" },
                "y1": { "type": "number" },
                "x2": { "type": "number" },
                "y2": { "type": "number" },
                "pts_per_ft": { "type": "number" },
                "label": { "type": "string" },
                "source": { "type": "string", "enum": ["preset", "calibrated"] },
                "preset_id": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "calibration_unit": {
      "type": "string",
      "enum": ["ft", "in"]
    },
    "tool_chest": {
      "type": "array",
      "description": "This takeoff's Tool Chest presets. Hand-made presets only carry id/tool/label/shapeClass/sizeDesignation/color; presets loaded from a company tool set (takeoffToolSets.toToolChestPreset) carry every tool field too (subject, symbol, symbol_size, show_numbers, line_width, line_style, fill_color, fill_opacity, scale_override, default_values, grade, unit_weight_lbs_per_ft, typical_length_ft, slope_deg, depth_ft) plus the fields below.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tool": { "type": "string", "enum": ["count", "bolt_count", "length", "polylength", "perimeter", "area", "wall_area", "volume", "radius", "diameter", "angle", "markup"], "description": "'markup' = a drawing-markup style saved with right-click > Add to Tool Chest (see markup_type / style); picking it starts that markup tool. Never a takeoff row." },
          "markup_type": { "type": "string", "description": "tool 'markup' only — drawing_markups[].type to draw." },
          "style": { "type": "object", "description": "tool 'markup' only — drawing_markups[].style to draw with." },
          "label": { "type": "string" },
          "shapeClass": { "type": "string" },
          "sizeDesignation": { "type": "string" },
          "color": { "type": "string" },
          "measurement_type": { "type": "string", "description": "Tool-set presets: the tool's own measurement type (same values as tool)." },
          "tool_set_id": { "type": "string", "description": "takeoff_tool_sets id (or 'builtin-structural-steel') the preset was loaded from." },
          "tool_set_tool_id": { "type": "string", "description": "id of the tool inside that tool set — copied onto every row measured with this preset." },
          "subject": { "type": "string" },
          "symbol": { "type": "string" },
          "marker_size": { "type": "number" },
          "slope": { "type": "object", "description": "Engine-shaped default slope ({ mode: 'degrees', degrees }) the confirmation panel starts from." }
        }
      }
    },
    "tool_set_id": {
      "type": "string",
      "description": "takeoff_tool_sets id (or 'builtin-structural-steel') last loaded into this takeoff as a whole set. Null when none."
    },
    "tool_set_snapshot": {
      "type": "object",
      "description": "Frozen copy (takeoffToolSets.createToolSet shape: name, tools[], columns[], version …) of that tool set as it was when loaded. The takeoff reads its company columns, subjects and line/fill styles from this copy, so editing or deleting the set in the library later never changes a takeoff already in progress."
    },
    "custom_columns": {
      "type": "array",
      "description": "This takeoff's own columns (takeoffColumns.js column shape: id, name, alias, type, choices, decimals, formula, default, unit). Shown after the tool set's columns; one with the same id/alias as a company column replaces it for this takeoff only (mergeColumns).",
      "items": { "type": "object" }
    },
    "legend_settings": {
      "type": "object",
      "description": "Legend per PDF page number: { on, anchor: 'top-left'|'top-right'|'bottom-left'|'bottom-right'|'custom', pdfX, pdfY (top-left corner in PDF space when anchor is 'custom' — set by dragging it on the drawing), group_by: 'tool'|'subject' }. Used on screen and in the exported PDF.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "on": { "type": "boolean" },
          "anchor": { "type": "string", "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "custom"] },
          "pdfX": { "type": "number" },
          "pdfY": { "type": "number" },
          "group_by": { "type": "string", "enum": ["tool", "subject"] }
        }
      }
    },
    "previous_takeoff_id": {
      "type": "string",
      "description": "The older revision's blueprint_takeoffs id when this session is a newer issue of the same drawing set (set by \"Load new revision…\" or by picking it in the compare dialog). Source for Compare and Bring markups forward."
    },
    "revision_compare": {
      "type": "object",
      "description": "Saved drawing-revision compares (RevisionCompareDialog). pages is keyed by THIS session's page number.",
      "properties": {
        "previous_takeoff_id": { "type": "string" },
        "pages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "previous_takeoff_id": { "type": "string" },
              "old_page_number": { "type": "number" },
              "transform": { "type": "object", "description": "Two-point line-up, old PDF space → new PDF space, affine { a, b, c, d, e, f } (x' = a·x + c·y + e, y' = b·x + d·y + f). Null = sheets compared as-is." },
              "clouds": {
                "type": "array",
                "description": "Changed areas in this page's PDF space — drawn as revision clouds, optionally exported, and used to flag carried-forward markups.",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" },
                    "kind": { "type": "string", "enum": ["added", "removed", "mixed"] }
                  }
                }
              },
              "stats": { "type": "object", "description": "{ added, removed, same } pixel counts at compare time." },
              "compared_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "page_notes": {
      "type": "object",
      "description": "Free-form notes keyed by PDF page number (e.g. { \"1\": \"note text\" }). Persisted 800ms after the estimator stops typing (same debounce as tool_chest) and restored into the Page Notes panel on openSession(); the panel swaps content to match whichever page is current as the estimator pages through the document.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "markup_weights": {
      "type": "object",
      "description": "Markups List weight settings, keyed by markup group key (`${tool}::${label}`, matching MarkupsList.jsx's internal grouping) so a Count group and a Length group sharing the same label don't collide. Persisted 800ms after the estimator stops editing (same debounce as tool_chest) and restored into the Markups List on openSession().",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unit_weight_lbs_per_ft": { "type": "number", "default": 0 },
          "typical_length_ft": { "type": "number", "default": 0, "description": "Count groups only — an assumed per-piece length (e.g. column height) needed to turn a piece count into a weight, since the Count tool itself never measures length." },
          "weight_source": { "type": "string", "enum": ["aisc", "manual", "override"], "default": "manual" }
        }
      }
    },
    "drawing_markups": {
      "type": "array",
      "description": "General drawing markups (Revu-style workspace — src/lib/drawingMarkups.js): pen, highlight, lines, arrows, shapes, clouds, text boxes, typewriter text, callouts, sticky notes and IRONSIGHT stamps. NOT takeoff rows: they never reach accepted_items, Push to Estimate or any tonnage total. Shown in the Markups List as type 'Markup' and exported with the marked-up PDF (FreeText / Text / Stamp / Line / PolyLine / Polygon / Square / Circle annotations in editable mode; drawn in flatten mode). Array order is z-order (last = on top). Saved 600ms after the last change by useDrawingMarkups.js.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "pen",
              "highlight",
              "line",
              "arrow",
              "polyline",
              "polygon",
              "rect",
              "ellipse",
              "cloud",
              "textbox",
              "typewriter",
              "callout",
              "note",
              "stamp"
            ]
          },
          "page_number": {
            "type": "number",
            "default": 1
          },
          "points": {
            "type": "array",
            "description": "PDF space (zoom 1, PDF points, y down — same as accepted_items). pen/highlight/polyline/polygon: every vertex; line/arrow: [start, end]; rect/ellipse/cloud/textbox/callout/stamp: [top-left, bottom-right] (text boxes grow downward to fit their text); typewriter/note: [top-left corner].",
            "items": {
              "type": "object",
              "properties": {
                "pdfX": {
                  "type": "number"
                },
                "pdfY": {
                  "type": "number"
                }
              }
            }
          },
          "leader": {
            "type": "object",
            "description": "callout only — the arrow tip, PDF space. The leader leaves from the middle of the nearest box side.",
            "properties": {
              "pdfX": {
                "type": "number"
              },
              "pdfY": {
                "type": "number"
              }
            }
          },
          "text": {
            "type": "string",
            "description": "textbox/typewriter/callout — the typed text (newlines kept; text boxes word-wrap to their width)."
          },
          "comment": {
            "type": "string",
            "description": "note — the sticky note's comment; any other markup — an optional comment (PDF annotation Contents)."
          },
          "stamp": {
            "type": "string",
            "enum": [
              "approved",
              "reviewed",
              "for_takeoff",
              "not_in_scope",
              "revised",
              "hold"
            ],
            "description": "stamp only — which IRONSIGHT stamp."
          },
          "style": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "description": "Line / border color (hex)."
              },
              "fill_color": {
                "type": "string",
                "description": "Fill (hex); empty = no fill."
              },
              "opacity": {
                "type": "number",
                "description": "0–1, whole markup."
              },
              "fill_opacity": {
                "type": "number",
                "description": "0–1, fill only."
              },
              "line_width": {
                "type": "number",
                "description": "PDF points (scales with zoom, like paper)."
              },
              "line_style": {
                "type": "string",
                "enum": [
                  "solid",
                  "dashed",
                  "dotted"
                ]
              },
              "font_family": {
                "type": "string",
                "enum": [
                  "Helvetica",
                  "Times",
                  "Courier"
                ]
              },
              "font_size": {
                "type": "number",
                "description": "PDF points."
              },
              "bold": {
                "type": "boolean"
              },
              "italic": {
                "type": "boolean"
              },
              "underline": {
                "type": "boolean"
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "text_color": {
                "type": "string"
              },
              "border": {
                "type": "boolean",
                "description": "textbox/callout — draw the box outline."
              }
            }
          },
          "subject": {
            "type": "string",
            "description": "Shown in the Markups List; PDF annotation subject."
          },
          "author": {
            "type": "string"
          },
          "locked": {
            "type": "boolean",
            "default": false,
            "description": "Locked markups can't be moved, resized, edited or deleted until unlocked."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "accepted_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_number": {
            "type": "number",
            "default": 1
          },
          "shape_type": {
            "type": "string"
          },
          "shape_code": {
            "type": "string",
            "description": "count/bolt_count only — the master catalog's short shape code (MaterialShapeType.shape_code, e.g. \"W\", \"HSS\", \"PL\") behind shape_type's human description. Needed to bridge into MaterialTakeoffLine's 5-value shape_class enum and to resolve weight-per-ft on push/save (see countShapeProfile.js) — shape_type alone (a free-text catalog description like \"Wideflange Beams\") doesn't match that enum."
          },
          "size_designation": {
            "type": "string"
          },
          "width_ft": {
            "type": "number",
            "default": 0,
            "description": "count only, Plate shape only — a plate's material requirement depends on length AND width, not thickness (size_designation) alone. Captured to 1/16\" precision alongside length_ft in Count Setup."
          },
          "bbox": {
            "type": "array",
            "items": { "type": "number" }
          },
          "confidence": {
            "type": "number"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_weight_lbs_per_ft": {
            "type": "number",
            "default": 0
          },
          "length_ft": {
            "type": "number",
            "default": 0
          },
          "unit_cost_cents": {
            "type": "number",
            "default": 0
          },
          "is_accepted": {
            "type": "boolean",
            "default": true
          },
          "notes": {
            "type": "string"
          },
          "is_demo": {
            "type": "boolean",
            "default": false
          },
          "source": {
            "type": "string",
            "enum": ["measurement"]
          },
          "tool": {
            "type": "string",
            "enum": ["count", "bolt_count", "length", "polylength", "perimeter", "area", "volume", "wall_area", "angle", "radius", "diameter"],
            "description": "'count' (beams/shapes) and 'bolt_count' (bolts/fasteners) share the same click-to-mark tally engine — see `points`/`color`/`symbol` below — parameterized only by which setup fields they prompt for (Shape/Size/Length vs. Size/Type/Grade). The drawn tools are defined in src/lib/takeoffGeometry.js MEASURE_TOOLS: length-kind (length, polylength, perimeter, radius, diameter -> length_ft, AISC lbs/ft applies), area-kind (area, wall_area -> area_sq_ft), volume (volume_cu_yd, never weighed), angle (angle_deg, never weighed)."
          },
          "marker_size": {
            "type": "number",
            "description": "count/bolt_count only — dot radius in screen px picked in Count Setup (5/7/10/14; null = default 7)."
          },
          "show_numbers": {
            "type": "boolean",
            "default": false,
            "description": "count/bolt_count only — draw a running number (1, 2, 3…) next to each dot in click order."
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "Hex color assigned to this count/bolt_count group's dots, picked from a ~20-color palette that resets per PDF page. Length/Area rows don't use this — they use `marker_color`'s green/blue/red status scheme instead."
          },
          "symbol": {
            "type": "string",
            "enum": ["square", "triangle", "diamond", "star", "pentagon", "hexagon", "cross"],
            "description": "count/bolt_count only — fallback dot shape used once a page's 20-color palette is exhausted (more than 20 distinct shape/size/length or bolt groups counted on one page)."
          },
          "grade": {
            "type": "string",
            "description": "count/bolt_count — the material grade captured during setup (e.g. A992 for a beam, A325 for a bolt), alongside shape_type/shape_code and size_designation."
          },
          "points": {
            "type": "array",
            "description": "count/bolt_count only — every individual click-to-mark dot placed for this tally session, in PDF space. `quantity` is always `points.length`. Resuming via \"Add Pieces\" reloads this array so more dots can be added to (or removed from) the same line item instead of creating a new one.",
            "items": {
              "type": "object",
              "properties": {
                "pdfX": { "type": "number" },
                "pdfY": { "type": "number" }
              }
            }
          },
          "pdfX": {
            "type": "number",
            "description": "Legacy single-click count row (pre-tally-engine), or the anchor of a drawn measurement other than Length (Area/Perimeter/Volume centroid, polyline middle, angle vertex, circle center) — where its status marker and label sit. New count/bolt_count rows use `points` instead."
          },
          "pdfY": {
            "type": "number"
          },
          "point1": {
            "type": "object",
            "properties": {
              "pdfX": { "type": "number" },
              "pdfY": { "type": "number" }
            }
          },
          "point2": {
            "type": "object",
            "properties": {
              "pdfX": { "type": "number" },
              "pdfY": { "type": "number" }
            }
          },
          "polyline_points": {
            "type": "array",
            "description": "polylength/wall_area — the clicked run, PDF space, in order.",
            "items": {
              "type": "object",
              "properties": {
                "pdfX": { "type": "number" },
                "pdfY": { "type": "number" }
              }
            }
          },
          "cutouts": {
            "type": "array",
            "description": "area/volume — inner polygons subtracted from polygon_points (each fully inside it).",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pdfX": { "type": "number" },
                  "pdfY": { "type": "number" }
                }
              }
            }
          },
          "angle_points": {
            "type": "array",
            "description": "angle — [arm end, vertex, arm end], PDF space."
          },
          "circle": {
            "type": "object",
            "description": "radius/diameter — circle in PDF space.",
            "properties": {
              "cx": { "type": "number" },
              "cy": { "type": "number" },
              "r": { "type": "number" }
            }
          },
          "circle_mode": { "type": "string", "enum": ["center", "three"], "description": "How the circle was picked: center + edge, or 3 points on the edge." },
          "circle_points": { "type": "array", "description": "radius/diameter — the clicks that defined the circle." },
          "plan_length_ft": { "type": "number", "description": "Length as drawn (flat), before slope. length_ft = plan_length_ft × slope_factor. For radius/diameter it's the ring length around the circle." },
          "plan_area_sq_ft": { "type": "number", "description": "area/volume — net plan area (gross minus cutouts), before slope." },
          "gross_area_sq_ft": { "type": "number", "description": "area/volume — outer shape area before cutouts." },
          "cutout_area_sq_ft": { "type": "number", "description": "area/volume — total of all cutouts." },
          "volume_cu_ft": { "type": "number", "description": "volume — plan_area_sq_ft × depth_ft." },
          "volume_cu_yd": { "type": "number", "description": "volume — volume_cu_ft / 27. What Push to Estimate carries." },
          "angle_deg": { "type": "number", "description": "angle — 0–180°." },
          "radius_ft": { "type": "number" },
          "diameter_ft": { "type": "number" },
          "depth_ft": { "type": "number", "description": "volume — depth/thickness entered on confirm." },
          "height_ft": { "type": "number", "description": "wall_area — wall height entered on confirm; area_sq_ft = length_ft × height_ft." },
          "slope": {
            "type": "object",
            "description": "length/polylength/perimeter/area — { mode: 'pitch', rise, run } (6:12) or { mode: 'degrees', degrees }. Null = flat.",
            "properties": {
              "mode": { "type": "string", "enum": ["pitch", "degrees"] },
              "rise": { "type": "number" },
              "run": { "type": "number" },
              "degrees": { "type": "number" }
            }
          },
          "slope_factor": { "type": "number", "default": 1, "description": "True/plan ratio: pitch sqrt(1 + (rise/run)^2), degrees 1/cos(θ). 6:12 -> 1.1180." },
          "scale_pts_per_ft": { "type": "number", "description": "The scale this measurement was taken at (viewport containing its first click, else page, else legacy px_per_ft). Stored so a later scale change doesn't silently rewrite saved quantities." },
          "scale_source": { "type": "string", "enum": ["viewport", "page", "legacy"] },
          "scale_label": { "type": "string" },
          "scale_viewport_id": { "type": "string", "description": "page_scales[page].viewports[].id when measured inside a viewport." },
          "polygon_points": {
            "type": "array",
            "description": "area/volume/perimeter — closed outer shape, PDF space.",
            "items": {
              "type": "object",
              "properties": {
                "pdfX": { "type": "number" },
                "pdfY": { "type": "number" }
              }
            }
          },
          "area_sq_ft": {
            "type": "number"
          },
          "pushed_to_estimate": {
            "type": "boolean",
            "default": false,
            "description": "Set once this row's markup group has been pushed to a MaterialTakeoffLine record — drives the green checkmark / Re-push state in the Markups List."
          },
          "pushed_material_line_id": {
            "type": "string",
            "description": "id of the MaterialTakeoffLine record this row's markup group was pushed to. Re-pushing updates this record instead of creating a duplicate. Kept on markups brought forward to a newer revision, so pushing the new revision updates the same estimate line."
          },
          "column_values": {
            "type": "object",
            "description": "Typed values for this markup's non-formula custom columns, keyed by column id (formula columns are never stored — recalculated every time).",
            "additionalProperties": {}
          },
          "tool_set_id": { "type": "string", "description": "Tool set the row's preset came from." },
          "tool_set_tool_id": { "type": "string", "description": "Tool (inside tool_set_snapshot) the row was measured with — supplies its legend/export style and default column values." },
          "subject": { "type": "string", "description": "Group heading from the tool (e.g. Framing) — legend group-by and PDF annotation subject." },
          "measurement_type": { "type": "string", "description": "The tool's own type when it differs from `tool`." },
          "show_numbers": { "type": "boolean", "description": "count/bolt_count — number each mark 1, 2, 3 … on the drawing." },
          "carried_from_takeoff_id": { "type": "string", "description": "Set on markups brought forward from an older revision: that session's id." },
          "carried_from_row_id": { "type": "string", "description": "id of the markup it was copied from (so it can't be brought over twice)." },
          "review_flag": { "type": "string", "enum": ["area_changed"], "description": "\"Check — area changed\": brought forward into a saved change cloud. Cleared (null) when the estimator clicks Checked." },
          "review_note": { "type": "string" },
          "locked": { "type": "boolean", "default": false, "description": "Locked from the workspace (right-click > Lock / Properties): can't be deleted from the drawing, the Delete key or Properties, and its fields can't be edited in Properties, until unlocked. Takeoff rows are never dragged on the drawing either way." },
          "shape_class": { "type": "string", "enum": ["W-Beam", "HSS Tube", "C-Channel", "L-Angle", "PL-Plate"], "description": "steelShapeSelector SHAPE_CLASSES value. Takeoff Grid rows and rows measured with a tool-set tool (copied from the tool's shapeClass); custom-column weight lookup reads the class from the size itself first." }
        }
      }
    },
    "total_cost_cents": {
      "type": "number",
      "default": 0
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "file_url"
  ]
}
