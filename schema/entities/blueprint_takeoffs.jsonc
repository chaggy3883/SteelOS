{
  "name": "blueprint_takeoffs",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "takeoff_name": {
      "type": "string"
    },
    "last_opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "has_stored_pdf": {
      "type": "boolean",
      "default": false
    },
    "sheet_count": {
      "type": "number",
      "default": 1
    },
    "scale_reference": {
      "type": "string"
    },
    "px_per_ft": {
      "type": "number"
    },
    "calibration_unit": {
      "type": "string",
      "enum": ["ft", "in"]
    },
    "tool_chest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tool": { "type": "string", "enum": ["count", "length", "area"] },
          "label": { "type": "string" },
          "shapeClass": { "type": "string" },
          "sizeDesignation": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    },
    "page_notes": {
      "type": "object",
      "description": "Free-form notes keyed by PDF page number (e.g. { \"1\": \"note text\" }). Persisted 800ms after the estimator stops typing (same debounce as tool_chest) and restored into the Page Notes panel on openSession(); the panel swaps content to match whichever page is current as the estimator pages through the document.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "markup_weights": {
      "type": "object",
      "description": "Markups List weight settings, keyed by markup group key (`${tool}::${label}`, matching MarkupsList.jsx's internal grouping) so a Count group and a Length group sharing the same label don't collide. Persisted 800ms after the estimator stops editing (same debounce as tool_chest) and restored into the Markups List on openSession().",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unit_weight_lbs_per_ft": { "type": "number", "default": 0 },
          "typical_length_ft": { "type": "number", "default": 0, "description": "Count groups only — an assumed per-piece length (e.g. column height) needed to turn a piece count into a weight, since the Count tool itself never measures length." },
          "weight_source": { "type": "string", "enum": ["aisc", "manual", "override"], "default": "manual" }
        }
      }
    },
    "accepted_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_number": {
            "type": "number",
            "default": 1
          },
          "shape_type": {
            "type": "string"
          },
          "size_designation": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "items": { "type": "number" }
          },
          "confidence": {
            "type": "number"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_weight_lbs_per_ft": {
            "type": "number",
            "default": 0
          },
          "length_ft": {
            "type": "number",
            "default": 0
          },
          "unit_cost_cents": {
            "type": "number",
            "default": 0
          },
          "is_accepted": {
            "type": "boolean",
            "default": true
          },
          "notes": {
            "type": "string"
          },
          "is_demo": {
            "type": "boolean",
            "default": false
          },
          "source": {
            "type": "string",
            "enum": ["measurement"]
          },
          "tool": {
            "type": "string",
            "enum": ["count", "bolt_count", "length", "area"],
            "description": "'count' (beams/shapes) and 'bolt_count' (bolts/fasteners) share the same click-to-mark tally engine — see `points`/`color`/`symbol` below — parameterized only by which setup fields they prompt for (Shape/Size/Length vs. Size/Type/Grade)."
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "Hex color assigned to this count/bolt_count group's dots, picked from a ~20-color palette that resets per PDF page. Length/Area rows don't use this — they use `marker_color`'s green/blue/red status scheme instead."
          },
          "symbol": {
            "type": "string",
            "enum": ["square", "triangle", "diamond", "star", "pentagon", "hexagon", "cross"],
            "description": "count/bolt_count only — fallback dot shape used once a page's 20-color palette is exhausted (more than 20 distinct shape/size/length or bolt groups counted on one page)."
          },
          "grade": {
            "type": "string",
            "description": "bolt_count only — the bolt grade captured during setup (e.g. A325), alongside shape_type ('Type') and size_designation ('Size')."
          },
          "points": {
            "type": "array",
            "description": "count/bolt_count only — every individual click-to-mark dot placed for this tally session, in PDF space. `quantity` is always `points.length`. Resuming via \"Add Pieces\" reloads this array so more dots can be added to (or removed from) the same line item instead of creating a new one.",
            "items": {
              "type": "object",
              "properties": {
                "pdfX": { "type": "number" },
                "pdfY": { "type": "number" }
              }
            }
          },
          "pdfX": {
            "type": "number",
            "description": "Legacy single-click count row (pre-tally-engine) or Area centroid. New count/bolt_count rows use `points` instead."
          },
          "pdfY": {
            "type": "number"
          },
          "point1": {
            "type": "object",
            "properties": {
              "pdfX": { "type": "number" },
              "pdfY": { "type": "number" }
            }
          },
          "point2": {
            "type": "object",
            "properties": {
              "pdfX": { "type": "number" },
              "pdfY": { "type": "number" }
            }
          },
          "polygon_points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pdfX": { "type": "number" },
                "pdfY": { "type": "number" }
              }
            }
          },
          "area_sq_ft": {
            "type": "number"
          },
          "pushed_to_estimate": {
            "type": "boolean",
            "default": false,
            "description": "Set once this row's markup group has been pushed to a MaterialTakeoffLine record — drives the green checkmark / Re-push state in the Markups List."
          },
          "pushed_material_line_id": {
            "type": "string",
            "description": "id of the MaterialTakeoffLine record this row's markup group was pushed to. Re-pushing updates this record instead of creating a duplicate."
          }
        }
      }
    },
    "total_cost_cents": {
      "type": "number",
      "default": 0
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "file_url"
  ]
}
