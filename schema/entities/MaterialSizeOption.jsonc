{
  "name": "MaterialSizeOption",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "shape_type_id": {
      "type": "string",
      "description": "FK to MaterialShapeType.id — resolved from the shared shape_code at seed/create time, not stored redundantly here."
    },
    "size_value": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "shape_type_id",
    "size_value"
  ]
}
