{
  "name": "MaterialSizeOption",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "shape_type_id": {
      "type": "string",
      "description": "FK to MaterialShapeType.id — resolved from the shared shape_code at seed/create time, not stored redundantly here."
    },
    "size_value": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "weight_per_ft": {
      "type": "number",
      "description": "Saved lb/ft for a linear size. Read FIRST by materialEntryMath.calcCatalogRow (before steel_catalog, AISC, computed, estimator) and shown as 'Saved weight'."
    },
    "weight_per_sq_ft": {
      "type": "number",
      "description": "Saved lb/sq ft for a plate-family size (plate, sheet, grating, deck, expanded metal)."
    },
    "weight_per_each": {
      "type": "number",
      "description": "Saved lb/ea for an each-family size (bolts, nuts, washers, anchors, hardware)."
    },
    "weight_source": {
      "type": "string",
      "enum": ["typed", "admin", "aisc", "import"],
      "description": "Who set the stored weight: 'typed' = the first weight typed on a takeoff for a size that had none (saved once, then read by every takeoff), 'admin' = set on the Material Catalog page, 'aisc' = copied from the AISC table, 'import' = a bulk import. Only admins can change a stored weight (src/lib/materialCatalogRoles.js)."
    },
    "weight_set_by": {
      "type": "string",
      "description": "Email (or name) of whoever last set or cleared the stored weight."
    },
    "weight_set_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the stored weight was last set or cleared."
    },
    "created_by": {
      "type": "string",
      "description": "Email (or name) of whoever added the row. Seed rows: 'system-seed' or blank."
    },
    "created_from": {
      "type": "string",
      "enum": ["takeoff", "ironsight", "admin"],
      "description": "Where the row was added: Full Takeoff's '+ Add size', IRONSIGHT (measurement panel / Count setup / takeoff grid / Markups List weight save), or the Material Catalog admin page. Blank for seed rows. Drives the admin page's 'Added from a takeoff' filter."
    }
  },
  "required": [
    "shape_type_id",
    "size_value"
  ]
}
