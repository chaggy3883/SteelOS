{
  "name": "MaterialTakeoffLine",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string"
    },
    "material_type": {
      "type": "string"
    },
    "shape_class": {
      "type": "string",
      "enum": [
        "W-Beam",
        "HSS Tube",
        "C-Channel",
        "L-Angle",
        "PL-Plate"
      ]
    },
    "material_size": {
      "type": "string"
    },
    "custom_name": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "length_raw": {
      "type": "string"
    },
    "length_ft": {
      "type": "number",
      "default": 0
    },
    "length_decimal_ft": {
      "type": "number",
      "default": 0,
      "description": "Deprecated — superseded by length_ft. Kept because FullTakeoff.jsx still reads it as a fallback for old rows."
    },
    "coating_type": {
      "type": "string",
      "enum": [
        "No Coating",
        "Paint",
        "Galvanized"
      ],
      "default": "No Coating"
    },
    "paint_area_sq_in": {
      "type": "number",
      "default": 0
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "weight_per_ft": {
      "type": "number",
      "default": 0
    },
    "tons_per_piece": {
      "type": "number",
      "default": 0
    },
    "total_tons": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "bid_id",
    "material_type"
  ]
}
