{
  "name": "remnant_inventory",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "material_shape": {
      "type": "string"
    },
    "dimensions": {
      "type": "string"
    },
    "length_in": {
      "type": "number",
      "default": 0
    },
    "heat_number_string": {
      "type": "string"
    },
    "source_project_id": {
      "type": "string"
    },
    "inventory_zone_id": {
      "type": "string"
    },
    "material_grade": {
      "type": "string",
      "description": "Stage 10: needed alongside material_shape to match a remnant against a Material Optimization group's shape+grade key (src/lib/materialOptimizer.js's materialGroupKey) — a remnant is only usable stock for pieces of the same grade. Blank on older/manually-logged rows predating this field; those never match against a group since the key comparison requires both sides."
    },
    "status": {
      "type": "string",
      "enum": ["available", "consumed", "removed"],
      "default": "available",
      "description": "Stage 10: 'consumed' once a later Material Optimization run has cut one or more pieces from this remnant — kept as a record rather than deleted, same posture as StockMaterialUnit.status. 'removed' is the same kept-as-a-record posture, for a remnant pulled out of circulation via Inventory.jsx's \"Remove from Inventory\" action (added in error, damaged, scrapped, or otherwise unusable) rather than consumed by production — see removed_reason/removed_date. Only 'available' remnants are offered when a new run checks for usable existing stock."
    },
    "source_material_optimization_run_id": {
      "type": "string",
      "description": "Stage 10: FK to the MaterialOptimizationRun this remnant was logged from, when created via the \"Log Remnant\" action on a committed StockMaterialUnit rather than entered manually."
    },
    "source_stock_material_unit_id": {
      "type": "string",
      "description": "Stage 10: FK to the specific StockMaterialUnit (physical bar) this remnant was cut from, when known — see StockMaterialUnit.remnant_logged."
    },
    "consumed_by_material_optimization_run_id": {
      "type": "string",
      "description": "Stage 10: FK to the later MaterialOptimizationRun that consumed this remnant, once status is 'consumed'."
    },
    "consumed_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Condition/notes captured when this leftover was logged (e.g. 'Add Leftover to Inventory' manual entry on Inventory.jsx) — separate from heat_number_string, which is metallurgical, not descriptive."
    },
    "qr_payload_string": {
      "type": "string",
      "description": "QR lifecycle: generated via generatePiecePayload() (qrSerialization.js) the moment this remnant is logged, while it's still unassigned — this is the SAME payload that ends up on a PieceMark if this remnant is later whole-piece-matched to a new piece (see PieceMark.qr_payload_string's description and detailerImportCommit.js's commitBatch), never regenerated. The physical label printed for this remnant (reuses the barcode-printing pipeline's Material_Stock label type) never changes even after that transfer — only which record 'owns' the payload moves. Blank on remnants logged before this field existed or via the older Stage 10 'Log Remnant' action — those are cut-plan stock only, never offered as a whole-piece match (see findWholePieceRemnantMatches in materialOptimizer.js)."
    },
    "is_assigned": {
      "type": "boolean",
      "default": false,
      "description": "QR lifecycle: false while this remnant sits in inventory, searchable/matchable against a new project's Detailer Import batch. Set true the moment it's whole-piece-matched and consumed by a new PieceMark (commitBatch in detailerImportCommit.js) — status is set to 'consumed' at the same time so it also drops out of the older Stage 10 cut-plan remnant search (findMatchingRemnants), since the physical piece no longer exists as raw stock either way."
    },
    "assigned_project_id": {
      "type": "string",
      "description": "FK to Project — set alongside is_assigned:true, the project whose Detailer Import batch consumed this remnant. Null while unassigned. Distinct from source_project_id, which is where the leftover material ORIGINALLY came from."
    },
    "assigned_piece_mark_id": {
      "type": "string",
      "description": "FK to PieceMark — the specific new piece that received this remnant's qr_payload_string, set alongside is_assigned:true. Null while unassigned."
    },
    "removed_reason": {
      "type": "string",
      "description": "Set alongside status:'removed' via Inventory.jsx's \"Remove from Inventory\" action — a required reason (e.g. 'Added in error', 'Damaged', 'Scrapped', or free-text 'Other'). Null unless status is 'removed'."
    },
    "removed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Set alongside status:'removed' — when this remnant was pulled out of circulation. Null unless status is 'removed'."
    },
    "rack": {
      "type": "string",
      "description": "Optional rack within inventory_zone_id, shown inline on the Drop Pieces list row alongside the resolved zone name so a drop can be located at a glance — same free-text convention as InventoryItem.warehouse_rack."
    },
    "bin": {
      "type": "string",
      "description": "Optional bin within rack/inventory_zone_id — same free-text convention as InventoryItem.warehouse_bin."
    },
    "used_reason": {
      "type": "string",
      "enum": ["project_assignment", "other"],
      "description": "Set by the \"Use this Drop\" action (RemnantInventoryDetailModal.jsx) alongside status:'consumed' — 'project_assignment' when assigned to a project (see assigned_project_id/assigned_piece_mark_id, is_assigned also set true), 'other' for an internal-use reason not tied to any project (used_note is required in that case; is_assigned stays false since nothing was actually assigned). Null until used."
    },
    "used_note": {
      "type": "string",
      "description": "Free-text note captured by the \"Use this Drop\" action. Required when used_reason is 'other' (e.g. shop repair, internal use); optional additional context when used_reason is 'project_assignment'."
    },
    "used_by": {
      "type": "string",
      "description": "Display name of the user who performed the \"Use this Drop\" action, captured at that moment. The automatic per-field AuditLog entry this update() call also writes already attributes the change to the acting user_id/user_name — this is kept on the record itself too so the detail view can show it directly without a join."
    }
  },
  "required": [
    "material_shape"
  ]
}
