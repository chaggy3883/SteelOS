{
  "name": "receiving_logs",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "po_id": {
      "type": "string"
    },
    "po_number": {
      "type": "string"
    },
    "quantity_ordered": {
      "type": "number",
      "default": 0
    },
    "quantity_received": {
      "type": "number",
      "default": 0
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "Received Complete",
        "Partial Delivery"
      ]
    },
    "packing_list": {
      "type": "string"
    },
    "material_heat_number": {
      "type": "string"
    },
    "attachment_path": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "line_id": {
      "type": "string",
      "description": "Links to a specific purchase_order_line this delivery entry applies to."
    },
    "quantity_received_this_delivery": {
      "type": "number",
      "default": 0
    },
    "receiver_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "put_away_status": {
      "type": "string",
      "enum": ["pending", "stocked", "skipped"],
      "description": "Set to 'pending' when ReceivingKiosk.jsx creates the log; the guided Put it away step (src/components/receiving/PutAwayStep.jsx) flips it to 'stocked' (after writing a 'receive' inventory_transactions row for quantity_received_this_delivery) or 'skipped' (with put_away_skip_reason). Blank on logs created before put-away existed — those never touched stock."
    },
    "put_away_skip_reason": {
      "type": "string",
      "description": "Required when put_away_status is 'skipped', e.g. 'Going straight to a job — Smith Warehouse'."
    },
    "inventory_item_id": {
      "type": "string",
      "description": "FK to the InventoryItem this delivery was put away into (put_away_status 'stocked')."
    },
    "inventory_transaction_id": {
      "type": "string",
      "description": "FK to the 'receive' inventory_transactions row written for this delivery."
    },
    "put_away_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "po_id",
    "po_number"
  ]
}
