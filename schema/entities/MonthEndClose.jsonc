{
  "name": "MonthEndClose",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["In Progress", "Closed"],
      "default": "In Progress"
    },
    "closed_date": {
      "type": "string",
      "format": "date"
    },
    "closed_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "period"
  ]
}
