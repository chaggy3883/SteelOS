{
  "name": "employees",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_number": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Blank while the employee is currently employed. Added for Payroll Setup (end-dating pay rates/deductions/withholding at separation) — distinct from is_active, which has no date attached."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "pin_encrypted": {
      "type": "string"
    },
    "is_timeclock_locked": {
      "type": "boolean",
      "default": true
    },
    "has_w4_approved": {
      "type": "boolean",
      "default": false
    },
    "has_i9_approved": {
      "type": "boolean",
      "default": false
    },
    "ssn_last4": {
      "type": "string"
    },
    "pay_rate_cents": {
      "type": "number",
      "default": 0
    },
    "pay_type": {
      "type": "string",
      "enum": ["hourly", "salary"],
      "default": "hourly"
    },
    "annual_salary_cents": {
      "type": "number",
      "default": 0,
      "description": "Used when pay_type is 'salary' — pay_rate_cents is ignored in that case."
    },
    "is_flsa_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Exempt employees earn no overtime, regardless of pay_type."
    },
    "ot_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "department": {
      "type": "string"
    },
    "job_title": {
      "type": "string",
      "description": "General HR job title (e.g. 'Senior Ironworker', 'Shop Supervisor') — distinct from classification, which is the prevailing-wage/certified-payroll labor classification."
    },
    "supervisor_name": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date"
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "personal_email": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "emergency_contact_phone_alt": {
      "type": "string"
    },
    "is_active_login": {
      "type": "boolean",
      "default": true
    },
    "permission_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "platform_role": {
      "type": "string",
      "default": ""
    },
    "page_layouts_json": {
      "type": "object",
      "description": "Same per-page widget layout dictionary as User.page_layouts_json, for kiosk/employee-linked sessions. Deliberately never populated for 'employee_center' — that workspace is a locked, standard layout for every worker, not personalizable."
    }
  },
  "required": [
    "employee_number",
    "full_name"
  ]
}
