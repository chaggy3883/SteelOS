{
  "name": "employees",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_number": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Blank while the employee is currently employed. Added for Payroll Setup (end-dating pay rates/deductions/withholding at separation) — distinct from is_active, which has no date attached."
    },
    "termination_reason": {
      "type": "string",
      "enum": ["voluntary_resignation", "involuntary_discharge", "reduction_in_force", "retirement", "deceased", "other"],
      "description": "Set alongside termination_date by TerminationPanel.jsx. Never hidden — visible in the HR employee list and reports, not just the profile dialog."
    },
    "termination_reason_other": {
      "type": "string",
      "description": "Required free-text detail when termination_reason is 'other' — blank otherwise."
    },
    "final_notes": {
      "type": "string",
      "description": "Optional HR notes captured at termination (final_check context, exit-interview summary, etc.) — distinct from termination_reason_other, which is only the 'other' reason detail."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "pin_encrypted": {
      "type": "string"
    },
    "is_timeclock_locked": {
      "type": "boolean",
      "default": true
    },
    "has_w4_approved": {
      "type": "boolean",
      "default": false
    },
    "i9_on_file": {
      "type": "boolean",
      "default": false,
      "description": "Renamed from has_i9_approved. Whether Form I-9 Section 2 is on file. The actual scanned I-9 form is stored separately in employee_documents (document_type_key 'I9_Form') — this is a tracking flag only."
    },
    "i9_date": {
      "type": "string",
      "format": "date",
      "description": "Date the I-9 form was received/completed. Blank until i9_on_file is set."
    },
    "i9_reverification_due_date": {
      "type": "string",
      "format": "date",
      "description": "Federal reverification deadline. Auto-set to i9_date + 3 years (the default window for most work-authorization documents) by I9ComplianceCenter.jsx, but manually overridable by HR — e.g. for employees on 1-year visas whose document expires sooner. Also pre-set to hire_date + 3 years at provisioning (see employeesApi.js), before the actual I-9 is on file."
    },
    "i9_reverification_completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date HR actually completed the reverification. Blank until completed — set by the 'Mark Reverification Complete' action, which also rolls i9_reverification_due_date forward another 3 years."
    },
    "e_verify_status": {
      "type": "string",
      "enum": ["not_submitted", "pending", "verified", "failed", "expired"],
      "default": "not_submitted"
    },
    "e_verify_initiated_date": {
      "type": "string",
      "format": "date"
    },
    "e_verify_verified_date": {
      "type": "string",
      "format": "date"
    },
    "e_verify_recheck_due_date": {
      "type": "string",
      "format": "date",
      "description": "Optional manual recheck deadline (e.g. after a Tentative Nonconfirmation resolution window). Blank if no recheck is required."
    },
    "ssn_last4": {
      "type": "string",
      "description": "Also doubles as this employee's default kiosk/timeclock PIN (see src/lib/pinFormula.js) — HR can override with an independently chosen PIN via System Access Portal's setManualPin."
    },
    "pay_rate_cents": {
      "type": "number",
      "default": 0
    },
    "pay_type": {
      "type": "string",
      "enum": ["hourly", "salary"],
      "default": "hourly"
    },
    "annual_salary_cents": {
      "type": "number",
      "default": 0,
      "description": "Used when pay_type is 'salary' — pay_rate_cents is ignored in that case."
    },
    "is_flsa_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Exempt employees earn no overtime, regardless of pay_type."
    },
    "ot_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "department": {
      "type": "string"
    },
    "job_title": {
      "type": "string",
      "description": "General HR job title (e.g. 'Senior Ironworker', 'Shop Supervisor') — distinct from classification, which is the prevailing-wage/certified-payroll labor classification."
    },
    "is_salesman": {
      "type": "boolean",
      "default": false,
      "description": "Marks this employee as eligible for sales commission (SalesmanCommissionRate, ProjectCommission). Deliberately a dedicated flag rather than overloading job_title/classification or the unrelated RBAC platform_role field."
    },
    "supervisor_name": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date"
    },
    "address_street": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "personal_email": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "emergency_contact_phone_alt": {
      "type": "string"
    },
    "is_active_login": {
      "type": "boolean",
      "default": true
    },
    "permission_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "platform_role": {
      "type": "string",
      "default": ""
    },
    "page_layouts_json": {
      "type": "object",
      "description": "Same per-page widget layout dictionary as User.page_layouts_json, for kiosk/employee-linked sessions. Deliberately never populated for 'employee_center' — that workspace is a locked, standard layout for every worker, not personalizable."
    }
  },
  "required": [
    "employee_number",
    "full_name"
  ]
}
