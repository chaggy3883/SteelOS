{
  "name": "ApiCredential",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string",
      "enum": [
        "procore",
        "textura",
        "aws_s3",
        "avatax",
        "vertex",
        "tekla_api",
        "quickbooks"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "client_id_encrypted": {
      "type": "string"
    },
    "client_secret_encrypted": {
      "type": "string"
    },
    "access_token_encrypted": {
      "type": "string"
    },
    "api_endpoint": {
      "type": "string"
    },
    "webhook_url": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "bucket_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error",
        "untested"
      ],
      "default": "untested"
    },
    "last_tested": {
      "type": "string",
      "format": "date-time"
    },
    "last_test_message": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "service_name",
    "display_name"
  ]
}