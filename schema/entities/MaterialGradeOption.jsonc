{
  "name": "MaterialGradeOption",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "shape_type_id": {
      "type": "string",
      "description": "FK to MaterialShapeType.id — resolved from the shared shape_code at seed/create time, not stored redundantly here."
    },
    "grade_value": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_by": {
      "type": "string",
      "description": "Email (or name) of whoever added the row. Seed rows: 'system-seed' or blank."
    },
    "created_from": {
      "type": "string",
      "enum": ["takeoff", "ironsight", "admin"],
      "description": "Where the row was added: Full Takeoff's '+ Add size', IRONSIGHT (measurement panel / Count setup / takeoff grid / Markups List weight save), or the Material Catalog admin page. Blank for seed rows. Drives the admin page's 'Added from a takeoff' filter."
    }
  },
  "required": [
    "shape_type_id",
    "grade_value"
  ]
}
