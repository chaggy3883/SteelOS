{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "item_number": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "wide_flange",
        "hss",
        "angle",
        "channel",
        "plate",
        "rebar",
        "bolt",
        "weld_material",
        "paint",
        "other"
      ]
    },
    "material_grade": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "unit_of_measure": {
      "type": "string"
    },
    "quantity_on_hand": {
      "type": "number",
      "default": 0,
      "description": "Written only through src/lib/inventoryLedger.js (recordInventoryChange), which appends an inventory_transactions row for every change — never update this field directly."
    },
    "quantity_reserved": {
      "type": "number",
      "default": 0,
      "description": "Set aside for a job. Changed only via inventoryLedger.js reserve/release transactions."
    },
    "quantity_available": {
      "type": "number",
      "default": 0,
      "description": "Derived: max(0, quantity_on_hand - quantity_reserved), recomputed by inventoryLedger.js on every change."
    },
    "unit_cost": {
      "type": "number"
    },
    "warehouse_zone": {
      "type": "string",
      "description": "ShopFloorZone.id. warehouse_zone/rack/bin change only through inventoryLedger.js 'move' transactions (or a 'receive' put-away into a new spot) so moves are in the item's History."
    },
    "warehouse_rack": {
      "type": "string"
    },
    "warehouse_bin": {
      "type": "string"
    },
    "heat_number": {
      "type": "string",
      "description": "Single display heat. One item can hold several heats, so receiving only fills this when blank — each receipt's heat is kept on its own inventory_transactions row."
    },
    "mtr_url": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "reorder_point": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "description",
    "category"
  ],
  "name": "InventoryItem"
}