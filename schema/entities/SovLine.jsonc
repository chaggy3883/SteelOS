{
  "name": "SovLine",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "area_id": {
      "type": "string",
      "description": "The originating ProjectSequenceArea, when this line was auto-generated on bid win (createProjectFromWonBid in BidDetail.jsx). Null for a manually-created SOV line not tied to an Area. Lets a canceled Area's %/value be looked up directly instead of re-derived by hand."
    },
    "item_description": {
      "type": "string"
    },
    "cost_code": {
      "type": "string"
    },
    "original_scheduled_value": {
      "type": "number",
      "default": 0
    },
    "completion_percentage": {
      "type": "number",
      "default": 0
    },
    "current_billed_amount": {
      "type": "number",
      "default": 0
    },
    "retainage_rate": {
      "type": "number",
      "default": 0.10
    }
  },
  "required": [
    "project_id",
    "item_description"
  ]
}
