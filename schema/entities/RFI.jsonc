{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string",
      "description": "Optional link to the estimate/Bid this RFI traces back to — set via the Estimate/Bid picker in the create form."
    },
    "rfi_number": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "answered",
        "closed"
      ],
      "default": "draft"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "submitted_by": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "date_submitted": {
      "type": "string",
      "format": "date"
    },
    "date_required": {
      "type": "string",
      "format": "date"
    },
    "date_answered": {
      "type": "string",
      "format": "date"
    },
    "response": {
      "type": "string"
    },
    "csi_section": {
      "type": "string"
    },
    "drawing_reference": {
      "type": "string"
    },
    "spec_reference": {
      "type": "string"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "finding_id": {
      "type": "string"
    },
    "cost_impact": {
      "type": "string",
      "enum": [
        "none",
        "potential",
        "confirmed"
      ],
      "default": "none"
    },
    "schedule_impact": {
      "type": "string",
      "enum": [
        "none",
        "potential",
        "confirmed"
      ],
      "default": "none"
    },
    "notes": {
      "type": "string"
    },
    "created_by_role": {
      "type": "string",
      "enum": ["salesman", "project_manager", "inspector", "estimator", "other"],
      "description": "Snapshot of the creating user's primary role at creation time — drives notification routing (see src/lib/salesNotifications.js): a salesman-created RFI notifies PM/QA/Shop/Estimating, any other role's RFI notifies the project's salesman."
    },
    "pending_salesman_response": {
      "type": "boolean",
      "default": false,
      "description": "Set true when a non-salesman creates an RFI on a project with a salesman assigned — shows the 'Respond' action on the Salesman Dashboard's Recent RFIs widget. Cleared the next time the salesman saves a response."
    }
  },
  "required": [
    "project_id",
    "subject"
  ],
  "name": "RFI"
}