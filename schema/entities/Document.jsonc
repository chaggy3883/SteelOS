{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Required once this Document is tied to a project. Bid-stage uploads (before a project exists) use bid_id instead — one of project_id/bid_id is expected, not both required."
    },
    "bid_id": {
      "type": "string",
      "description": "Links to Bid — used for documents attached at the estimating stage before a project exists (the Bid page's Documents tab, T&M subcontractor quote attachments via TmSubcontractorLineItem.quote_document_id). Carried forward alongside a new project_id when the bid is won (see createProjectFromWonBid in BidDetail.jsx)."
    },
    "po_id": {
      "type": "string",
      "description": "Links to purchase_orders — set when this Document is the source quote/attachment for a PO (e.g. document_type 'vendor_quote')."
    },
    "vendor_bill_id": {
      "type": "string",
      "description": "Links to VendorBill — set when this Document is the source invoice for a vendor bill (document_type 'vendor_invoice')."
    },
    "rfi_id": {
      "type": "string",
      "description": "Links to RFI — set when this Document was attached via RFIs.jsx's general-purpose drag-and-drop attachment zone on a specific RFI (document_type 'rfi'). Drives the 'Open RFI' click-through on Documents.jsx. Distinct from the unrelated delay-notice flow's generated Documents (document_type 'delay_notice'), which have no rfi_id."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "specification",
        "contract",
        "general_conditions",
        "supplementary_conditions",
        "addendum",
        "delay_notice",
        "ifc",
        "structural_drawing",
        "architectural_drawing",
        "civil_drawing",
        "mechanical_drawing",
        "electrical_drawing",
        "geotechnical_report",
        "bid_form",
        "scope_letter",
        "meeting_minutes",
        "email",
        "rfi",
        "submittal",
        "excel_file",
        "word_document",
        "vendor_quote",
        "vendor_invoice",
        "mtr",
        "accounting",
        "legal_general",
        "close_out",
        "contract_review_aisc",
        "drawing_joist_deck",
        "leed",
        "notice_of_commencement",
        "notice_of_furnishing",
        "photo",
        "request_for_change",
        "safety",
        "schedule",
        "vendor_pricing",
        "front_end_review",
        "previous_recap_proposal",
        "bulletin",
        "other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "revision": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "processing",
        "analyzed",
        "reviewed",
        "approved",
        "superseded"
      ],
      "default": "uploaded"
    },
    "ai_processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "extracted_text": {
      "type": "string"
    },
    "page_count": {
      "type": "number"
    },
    "csi_divisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "virtual_path": {
      "type": "string",
      "default": "/"
    },
    "qr_payload": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "document_type"
  ],
  "name": "Document"
}