{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string",
      "description": "Links to Bid — used for documents attached at the estimating stage before a project exists (e.g. SmartFileDump uploads, T&M subcontractor quote attachments via TmSubcontractorLineItem.quote_document_id)."
    },
    "po_id": {
      "type": "string",
      "description": "Links to purchase_orders — set when this Document is the source quote/attachment for a PO (e.g. document_type 'vendor_quote')."
    },
    "vendor_bill_id": {
      "type": "string",
      "description": "Links to VendorBill — set when this Document is the source invoice for a vendor bill (document_type 'vendor_invoice')."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "specification",
        "contract",
        "general_conditions",
        "supplementary_conditions",
        "addendum",
        "delay_notice",
        "ifc",
        "structural_drawing",
        "architectural_drawing",
        "civil_drawing",
        "mechanical_drawing",
        "electrical_drawing",
        "geotechnical_report",
        "bid_form",
        "scope_letter",
        "meeting_minutes",
        "email",
        "rfi",
        "submittal",
        "excel_file",
        "word_document",
        "vendor_quote",
        "vendor_invoice",
        "mtr",
        "other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "revision": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "processing",
        "analyzed",
        "reviewed",
        "approved",
        "superseded"
      ],
      "default": "uploaded"
    },
    "ai_processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "extracted_text": {
      "type": "string"
    },
    "page_count": {
      "type": "number"
    },
    "csi_divisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "virtual_path": {
      "type": "string",
      "default": "/"
    },
    "qr_payload": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "name",
    "document_type"
  ],
  "name": "Document"
}