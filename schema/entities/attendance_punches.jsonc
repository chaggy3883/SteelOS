{
  "name": "attendance_punches",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "terminal_id": {
      "type": "string"
    },
    "punch_type": {
      "type": "string",
      "enum": [
        "Clock_In",
        "Clock_Out",
        "Start_Break",
        "End_Break"
      ]
    },
    "project_id": {
      "type": "string"
    },
    "labor_activity_category": {
      "type": "string",
      "enum": [
        "Shop_Fab",
        "Drill_Line",
        "Welding",
        "Paint",
        "Field_Erection"
      ]
    },
    "punch_time": {
      "type": "string",
      "format": "date-time"
    },
    "total_regular_minutes": {
      "type": "number",
      "default": 0
    },
    "total_overtime_minutes": {
      "type": "number",
      "default": 0
    },
    "is_mobile_remote_punch": {
      "type": "boolean",
      "default": false
    },
    "punch_in_location_coordinates": {
      "type": ["string", "null"]
    },
    "punch_out_location_coordinates": {
      "type": ["string", "null"]
    },
    "note": {
      "type": ["string", "null"],
      "description": "Optional, informational-only note the employee attaches at punch time or edits later from their own punch history (e.g. 'Clocked in late due to traffic'). Never blocks the punch itself."
    },
    "note_added_after_cutoff": {
      "type": "boolean",
      "default": false,
      "description": "Set true once, permanently, if the note on this punch was added/edited after the punch's own date fell inside a pay period whose PayrollRun is already 'locked' — flags it for payroll_admin review in TimeEntryPanel.jsx. Never cleared by a later edit; note_reviewed_by/note_reviewed_at track the review separately."
    },
    "note_reviewed_by": {
      "type": ["string", "null"],
      "description": "Set when payroll_admin/admin acknowledges a note_added_after_cutoff punch in TimeEntryPanel.jsx's Punch Notes review section."
    },
    "note_reviewed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "required": [
    "employee_id",
    "punch_type",
    "punch_time"
  ]
}
