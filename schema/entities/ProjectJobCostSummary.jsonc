{
  "name": "ProjectJobCostSummary",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "cost_code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cost_class": {
      "type": "string",
      "enum": ["LAB", "MAT", "SUB", "DEB", "OTH", "FRT", "OFB"]
    },
    "original_estimate": {
      "type": "number",
      "default": 0
    },
    "approved_co": {
      "type": "number",
      "default": 0
    },
    "revised_estimated_cost": {
      "type": "number",
      "default": 0
    },
    "jtd_hours": {
      "type": "number",
      "default": 0,
      "description": "Legacy hand-entered field — no longer written by Accounting.jsx. Job Cost Detail now computes JTD hours live from JobLaborAllocation instead of trusting a manually-typed number (see src/lib/jobCostEngine.js). Left on the schema only because pre-existing rows still carry it."
    },
    "jtd_costs": {
      "type": "number",
      "default": 0,
      "description": "Legacy hand-entered field — no longer written by Accounting.jsx. Job Cost Detail now computes JTD costs live by blending JobCostLedgerEntry and cost-coded credit_card_expenses (see src/lib/jobCostEngine.js). Left on the schema only because pre-existing rows still carry it."
    },
    "profit_loss": {
      "type": "number",
      "default": 0,
      "description": "Legacy hand-entered field — no longer written by Accounting.jsx. Job Cost Detail now computes this live as revised_estimated_cost minus the computed jtd_costs (see src/lib/jobCostEngine.js). Left on the schema only because pre-existing rows still carry it."
    },
    "source_report_name": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "// note": "Soft-delete marker — handleDeleteRow in Accounting.jsx sets this instead of calling .delete(), so a row's history survives removal from the UI."
    },
    "deleted_reason": {
      "type": "string"
    },
    "deleted_by": {
      "type": "string"
    },
    "deleted_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "cost_code",
    "cost_class"
  ]
}
