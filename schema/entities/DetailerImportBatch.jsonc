{
  "name": "DetailerImportBatch",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "detailer_name": {
      "type": "string"
    },
    "uploaded_files": {
      "type": "array",
      "description": "One entry per uploaded file: { file_id, file_name, file_type, file_url, uploaded_at, parsed, parsed_row_count, parsed_error_count }. file_id keys the raw blob in detailerImportBlobStore.js (IndexedDB, per-browser only). uploaded_at is an ISO timestamp set when the file is added, shown in BatchReviewModal.jsx's Attached Drawings section. parsed/parsed_row_count/parsed_error_count are set once a .csv or .kss file has been staged into DetailerImportedPiece rows; other file types (PDF, DXF, DSTV, etc.) are intake-only and never gain those fields — see isParsableDetailerFile/isCncFile/isDrawingFile in detailerImportParser.js for how a non-data file is further classified as a CNC hand-off file vs. a drawing."
    },
    "import_status": {
      "type": "string",
      "enum": ["uploaded", "parsed", "validated", "committed", "error"],
      "default": "uploaded",
      "description": "uploaded: files intake-only, nothing parsed yet. parsed: at least one file has been staged into DetailerImportedPiece rows. validated: the review screen has run batch-wide validation (duplicate piece marks, missing fields, catalog-shape matching) at least once. committed: the Commit action has run at least once (non-error rows promoted onto PieceMark) — a batch can still have error rows left over even once committed, since commit skips them rather than blocking the whole batch. error: a parse attempt failed outright (unreadable file / no rows found)."
    },
    "created_by": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string",
      "description": "The uploading user's email address, captured separately from created_by (which prefers full_name for display and only falls back to email when a full_name isn't set) — export cover sheets (detailerImportBatchReviewPdf.js/detailerImportBatchReviewXlsx.js) need the real address specifically, not whichever display string created_by happened to resolve to. Blank on any batch uploaded before this field existed."
    },
    "sequence_area_id": {
      "type": "string",
      "description": "Links to ProjectSequenceArea — the sequence/area this whole batch's upload was for, chosen once at upload time (DetailerImports.jsx prompts for it immediately after project selection, only when the project has any ProjectSequenceArea rows defined). Nullable — either the project has no sequence/area structure at all, or the user explicitly chose \"Unassigned\" in that prompt. Carried onto every DetailerImportedPiece row staged from this batch's files as their default sequence_area_id (parseFile in DetailerImports.jsx), which the reviewer can still override per row on the Review & Commit screen (BatchReviewModal.jsx) exactly like before this field existed — this is only a batch-level default, never a per-row lock."
    }
  },
  "required": [
    "project_id",
    "detailer_name"
  ]
}
