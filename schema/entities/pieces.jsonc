{
  "name": "pieces",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "piece_mark": {
      "type": "string"
    },
    "piece_mark_id": {
      "type": "string",
      "description": "FK back to the PieceMark record this shop-floor row represents — the bridge between the office piece list and shop floor scanning. Populated at creation time when a PieceMark with a matching project_id + piece_mark exists; blank otherwise."
    },
    "material_shape": {
      "type": "string"
    },
    "dimensions": {
      "type": "string"
    },
    "weight": {
      "type": "number",
      "default": 0
    },
    "blueprint_file_uri": {
      "type": "string"
    },
    "qr_payload_string": {
      "type": "string"
    },
    "current_station_id": {
      "type": "number",
      "enum": [1, 2, 3, 4, 5, 6],
      "default": 1
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "In_Fabrication",
        "Inspector_Queue",
        "Weld_Unlocked",
        "Paint_Unlocked",
        "Rejected"
      ],
      "default": "In_Fabrication"
    },
    "field_status": {
      "type": "string",
      "enum": [
        "In_Shop",
        "On_Site"
      ],
      "default": "In_Shop"
    }
  },
  "required": [
    "project_id",
    "piece_mark"
  ]
}
