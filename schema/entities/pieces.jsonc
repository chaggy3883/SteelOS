{
  "name": "pieces",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "piece_mark": {
      "type": "string"
    },
    "piece_mark_id": {
      "type": "string",
      "description": "FK back to the PieceMark record this shop-floor row represents — the bridge between the office piece list and shop floor scanning. Populated at creation time when a PieceMark with a matching project_id + piece_mark exists; blank otherwise."
    },
    "material_shape": {
      "type": "string"
    },
    "dimensions": {
      "type": "string"
    },
    "weight": {
      "type": "number",
      "default": 0
    },
    "blueprint_file_uri": {
      "type": "string"
    },
    "qr_payload_string": {
      "type": "string"
    },
    "qr_sequence_number": {
      "type": "number",
      "description": "Company-scoped sequential QR number assigned the first time this piece is included in a QR export (see src/lib/qrSequence.js). Blank until export — the UI shows the literal text \"Received\" in the QR column until then. Once set, it never changes: re-exporting a piece reuses this number rather than issuing a new one, since a physical label may already be printed against it."
    },
    "current_station_id": {
      "type": "number",
      "enum": [1, 2, 3, 4, 5, 6],
      "default": 1
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "In_Fabrication",
        "Received",
        "Inspector_Queue",
        "Weld_Unlocked",
        "Paint_Unlocked",
        "Rejected",
        "Paused"
      ],
      "default": "In_Fabrication",
      "description": "Received sits between In_Fabrication and the QA/tagging states: a fabricated piece manually checked in by office/receiving staff (see verified_by/verified_date) as physically staged and ready for a QR tag, distinct from the receiving_logs entity which tracks raw material/PO receiving instead. Paused is set only from the In_Fabrication scan-gated flow (ShopFabrication.jsx) when a worker explicitly pauses mid-work instead of finishing — current_worker_id is cleared at the same time so any authorized worker can resume it; resuming sets workflow_status back to In_Fabrication and current_worker_id to whoever resumed it. Prior elapsed time is never lost or reset on pause/resume — see station_logs, which already accumulates time across multiple start/stop sessions per piece."
    },
    "current_worker_id": {
      "type": "string",
      "description": "Nullable FK to employees.id — resolved from the typed Employee ID against employees.employee_number (same lookup assertStationCertClearance uses) at the moment work starts via scan or the Start Work button. Cleared (null) whenever the piece is paused or finished (station_logs closes to Paused or Complete), so it always reflects whether someone currently has an open station_logs session on this piece, never a stale prior worker. Not an access-control field — any authorized worker can pause or resume a piece regardless of who this points to."
    },
    "field_status": {
      "type": "string",
      "enum": [
        "In_Shop",
        "On_Site"
      ],
      "default": "In_Shop"
    },
    "verified_by": {
      "type": "string",
      "description": "Name of the office/receiving staff who marked this piece workflow_status='Received'. Set alongside verified_date."
    },
    "verified_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp this piece was marked workflow_status='Received'."
    }
  },
  "required": [
    "project_id",
    "piece_mark"
  ]
}
