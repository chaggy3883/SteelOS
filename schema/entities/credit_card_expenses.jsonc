{
  "name": "credit_card_expenses",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "card_last4": {
      "type": "string"
    },
    "merchant_name": {
      "type": "string"
    },
    "expense_category": {
      "type": "string",
      "enum": ["Lodging", "Meals", "Fuel", "Car_Rental", "Tolls_Parking", "Other"],
      "default": "Other"
    },
    "cost_code_id": {
      "type": "string",
      "description": "FK to CostCode — the code this expense should post against in job costing, same job-costing axis as TimeEntry.cost_code_id. Separate from expense_category (a free-text reimbursement/travel-policy tag) — a Fuel expense might code to a project's EQUIPMENT cost code, for example. Blank for overhead expenses with no project_id, which have nothing to job-cost against."
    },
    "amount_cents": {
      "type": "number",
      "default": 0
    },
    "expense_date": {
      "type": "string",
      "format": "date"
    },
    "receipt_file_uri": {
      "type": "string"
    },
    "per_diem_allowance_cents": {
      "type": "number",
      "default": 0
    },
    "is_out_of_town_travel": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": ["Pending", "Approved", "Reimbursed"],
      "default": "Pending"
    }
  },
  "required": [
    "employee_id",
    "expense_date",
    "amount_cents"
  ]
}
