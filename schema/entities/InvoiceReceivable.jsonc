{
  "name": "InvoiceReceivable",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "billing_period": {
      "type": "string"
    },
    "expected_payment_date": {
      "type": "string",
      "format": "date"
    },
    "gross_amount": {
      "type": "number",
      "default": 0
    },
    "retainage_held": {
      "type": "number",
      "default": 0
    },
    "net_billing": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": ["Draft", "Submitted", "Approved", "Released"],
      "default": "Draft"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Auto-set to the date payment_status is first changed to 'Released' (see handleSaveInvoice in Accounting.jsx) — the payment date used by triggerCommissionOnPayment."
    }
  },
  "required": [
    "project_id",
    "billing_period"
  ]
}
