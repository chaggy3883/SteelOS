{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "piece_mark": {
      "type": "string"
    },
    "assembly": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "weight_lbs": {
      "type": "number"
    },
    "material_grade": {
      "type": "string"
    },
    "finish": {
      "type": "string"
    },
    "lot": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "sequence_area_id": {
      "type": "string",
      "description": "Links to ProjectSequenceArea. Nullable — pieces with no assignment show under \"Unassigned\" rather than being hidden. Independent of the free-text phase/sequence fields above."
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_fabrication",
        "fabricated",
        "inspected",
        "painted",
        "shipped",
        "erected",
        "rejected"
      ],
      "default": "not_started"
    },
    "fab_start_date": {
      "type": "string",
      "format": "date"
    },
    "fab_complete_date": {
      "type": "string",
      "format": "date"
    },
    "ship_date": {
      "type": "string",
      "format": "date"
    },
    "erect_date": {
      "type": "string",
      "format": "date"
    },
    "barcode": {
      "type": "string"
    },
    "drawing_number": {
      "type": "string"
    },
    "heat_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "warehouse_zone": {
      "type": "string"
    },
    "warehouse_rack": {
      "type": "string"
    },
    "detailing_complete": {
      "type": "boolean",
      "default": false
    },
    "detailing_complete_date": {
      "type": "string",
      "format": "date"
    },
    "item_type": {
      "type": "string",
      "enum": ["Piece_Mark", "Loose_Part", "Bolt", "Embed", "Misc_Metal", "Lintel"],
      "default": "Piece_Mark"
    },
    "part_number": {
      "type": "string"
    },
    "bolt_size": {
      "type": "string",
      "description": "Free text, e.g. \"3/4 x 2-1/2\"."
    },
    "bolt_grade": {
      "type": "string",
      "description": "Free text, e.g. \"A325\", \"A490\"."
    },
    "stock_material_description": {
      "type": "string",
      "description": "e.g. \"L4x4x1/4 x 20'-0\"\"."
    },
    "parts_per_stock": {
      "type": "number",
      "default": 0,
      "description": "How many finished parts come out of one stock length. Always operator-entered — never derived from material dimensions or a lookup table. 0 means not applicable."
    },
    "stock_qty_required": {
      "type": "number",
      "default": 0,
      "description": "How many stock lengths to buy. Auto-computed as ceil(quantity / parts_per_stock) when parts_per_stock > 0, but an operator override always wins."
    },
    "actual_parts_yielded": {
      "type": "number",
      "default": 0
    },
    "scrap_qty": {
      "type": "number",
      "default": 0
    },
    "finished_length": {
      "type": "string",
      "description": "Detailer-reported finished piece length, kept as the free-text string it arrived in (e.g. \"32'-4 1/2\\\"\") rather than parsed into decimal feet — same precedent as pieces.dimensions. Populated when a DetailerImportedPiece staging row is promoted onto a PieceMark; not yet written by any other path."
    },
    "material_profile": {
      "type": "string",
      "description": "Shape/size designation as reported by the detailer (e.g. \"W12x26\"), free text — not validated against steel_catalog on this field itself (that check happens earlier, at DetailerImportedPiece review). Populated on promotion from a DetailerImportedPiece row; not yet written by any other path."
    },
    "revision": {
      "type": "string",
      "description": "Drawing revision letter/number (e.g. \"A\", \"R1\"). Populated on promotion from a DetailerImportedPiece row; not yet written by any other path."
    },
    "cnc_file_url": {
      "type": "string",
      "description": "Filename of an attached CNC cut/program file (e.g. \".nc\", \".dxf\", \".tap\"), if any — nullable/blank means no file attached. The actual blob lives in IndexedDB via src/lib/cncFileStore.js, keyed by this PieceMark's id; this field is only the presence flag + display name, not a resolvable URL (no backend to serve one from). Explicitly a file handoff for the operator to load into CNC software manually — no machine communication or G-code generation happens in this app. Attached via PieceMarkPdfIntake.jsx; shown as \"Open CNC File\" on ShopFabrication.jsx's Active Piece panel."
    }
  },
  "required": [
    "project_id",
    "piece_mark"
  ],
  "name": "PieceMark"
}