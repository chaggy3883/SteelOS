{
  "name": "StockLengthOption",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "steel_catalog_item_id": {
      "type": "string",
      "description": "FK to steel_catalog's own generated id (not its human-readable item_id field) — the specific shape/size this stock length belongs to."
    },
    "stock_length_in": {
      "type": "number",
      "description": "Stock bar/plate/shape length as it arrives from the mill/service center, in inches."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "vendor_id": {
      "type": "string",
      "description": "Optional FK to Vendor — the preferred supplier for this stock length, when one is set. Blank means no preferred vendor."
    },
    "cost_per_length": {
      "type": "number",
      "description": "Optional cost for one full stock length from vendor_id, when known. Blank, not zero, when unknown."
    },
    "created_by": {
      "type": "string",
      "description": "Email (or name) of whoever added the row. Seed rows: 'system-seed' or blank."
    },
    "created_from": {
      "type": "string",
      "enum": ["takeoff", "ironsight", "admin"],
      "description": "Where the row was added: Full Takeoff's '+ Add size', IRONSIGHT (measurement panel / Count setup / takeoff grid / Markups List weight save), or the Material Catalog admin page. Blank for seed rows. Drives the admin page's 'Added from a takeoff' filter."
    }
  },
  "required": [
    "steel_catalog_item_id",
    "stock_length_in"
  ]
}
