{
  "name": "PayrollRun",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "pay_period_id": {
      "type": "string"
    },
    "run_type": {
      "type": "string",
      "enum": ["regular", "final_check"],
      "default": "regular",
      "description": "'final_check' marks an off-cycle run created solely to pay out a terminated employee's remaining PTO (see processTerminationPtoSettlement in src/lib/ptoEngine.js) — kept out of the regular biweekly run entirely, on its own off_cycle PayPeriod, so a termination payout can never land in the same run as everyone else's regular wages."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "locked"],
      "default": "draft",
      "description": "'Run Payroll' creates a run directly in 'review' — nothing is final at that point. 'approved' requires all blocking pre-finalization control checks resolved or overridden (see PayrollRunPanel.jsx + payrollControls.js); 'locked' makes the source timecards read-only until an authorized role reopens it."
    },
    "run_date": {
      "type": "string",
      "format": "date"
    },
    "total_gross": {
      "type": "number",
      "default": 0
    },
    "total_net": {
      "type": "number",
      "default": 0
    },
    "total_employer_tax": {
      "type": "number",
      "default": 0
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_by": {
      "type": "string"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "reopened_by": {
      "type": "string"
    },
    "reopened_at": {
      "type": "string",
      "format": "date-time"
    },
    "reopen_reason": {
      "type": "string",
      "description": "Required whenever a locked run is reopened back to 'review' — also logged as a StatusHistoryEntry (entity_type 'PayrollRun', field_name 'status')."
    },
    "control_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_key": { "type": "string" },
          "note": { "type": "string" },
          "overridden_by": { "type": "string" },
          "overridden_at": { "type": "string", "format": "date-time" }
        }
      },
      "default": [],
      "description": "One entry per pre-finalization control check an authorized role explicitly overrode (with a required note) to allow Approve despite outstanding issues. Cleared on reopen, since a fresh review pass is required before the run can be approved/locked again."
    }
  },
  "required": [
    "pay_period_id",
    "status"
  ]
}
