{
  "name": "TakeoffLine",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string"
    },
    "cost_category": {
      "type": "string",
      "enum": [
        "detailing",
        "engineering",
        "bim",
        "structural_material",
        "bolts_fasteners",
        "outsourced_fabrication",
        "structural_fabrication",
        "galvanizing",
        "galvanizing_delivery",
        "processing_steel",
        "steel_rolling",
        "joist_deck",
        "anchor_bolts",
        "shop_priming",
        "primer_paint",
        "grating",
        "outsourced_paint",
        "outsourced_shot_blasting",
        "load_unload_material",
        "jobsite_freight",
        "misc_fab_structural",
        "misc_fab_processing",
        "misc_material",
        "steel_erection",
        "outsourced_misc_material_erection",
        "subcontractor_other",
        "allowances",
        "hss_contingency",
        "additional_cost_insurance",
        "additional_cost_leed_govt"
      ]
    },
    "cost_category_label": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "unit_of_measure": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number",
      "default": 0,
      "description": "For field_rigging/erection_labor_hours/load_unload_material/shop_priming/structural_fabrication, a brand-new line pre-fills this from the company's current CostCategoryDefaultRate for that category (admin-managed at /admin/bid-worksheet-rates) instead of 0 — see RATE_DEFAULT_CATEGORY_KEYS in TakeoffEngine.jsx. Independently editable per-line afterward; a saved line's value is never overwritten by a later default change."
    },
    "total_cost": {
      "type": "number",
      "default": 0
    },
    "markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "This line's own profit markup %. Quoted Price = total_cost * (1 + markup_percentage/100). Pre-filled from Bid.markup_percentage when the line is first created, then independently editable — see TakeoffEngine.jsx."
    },
    "tons": {
      "type": "number",
      "default": 0
    },
    "man_hours": {
      "type": "number",
      "default": 0
    },
    "is_auto_filled": {
      "type": "boolean",
      "default": false,
      "description": "True when TakeoffEngine.jsx filled this line's quantity from the Full Takeoff: primer_paint <- Bid.estimated_paint_area_sqft, galvanizing <- Bid.estimated_galvanizing_tons, structural_fabrication <- Bid.estimated_man_hours (rounded to 0.1 hr). While true and is_overridden is false, the quantity is refreshed from the bid every time the worksheet loads (rate/markup are kept)."
    },
    "is_overridden": {
      "type": "boolean",
      "default": false,
      "description": "True once the estimator types a different QUANTITY on an auto-filled line (rate/coverage/markup edits do not set it). Locks the quantity against later takeoff refreshes; the structural_fabrication line's 'Use takeoff hours' button clears it and re-attaches the line."
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "bim_import",
        "ai_parse",
        "vendor_pricing",
        "calculated"
      ],
      "default": "manual"
    },
    "notes": {
      "type": "string"
    },
    "tax_rate_override": {
      "type": "number",
      "default": 0
    },
    "coverage_rate": {
      "type": "number",
      "default": 300
    }
  },
  "required": [
    "bid_id",
    "cost_category"
  ]
}