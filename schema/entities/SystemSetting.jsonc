{
  "name": "SystemSetting",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "setting_group": {
      "type": "string",
      "enum": [
        "cost_variables",
        "general",
        "estimating",
        "accounting",
        "production"
      ],
      "default": "cost_variables"
    },
    "shop_burden_rate": {
      "type": "number",
      "default": 65
    },
    "standard_scrap_factor_pct": {
      "type": "number",
      "default": 5
    },
    "base_insurance_multiplier_pct": {
      "type": "number",
      "default": 3
    },
    "retainage_default_pct": {
      "type": "number",
      "default": 10
    },
    "default_labor_rate": {
      "type": "number",
      "default": 45
    },
    "overhead_pct": {
      "type": "number",
      "default": 12
    },
    "profit_margin_default_pct": {
      "type": "number",
      "default": 15
    },
    "fab_shop_rate": {
      "type": "number",
      "default": 85
    },
    "field_erection_rate": {
      "type": "number",
      "default": 95
    },
    "max_shop_capacity_tons_weekly": {
      "type": "number",
      "default": 150
    },
    "stale_piece_alert_hours": {
      "type": "number",
      "default": 8
    },
    "station_bottleneck_threshold": {
      "type": "number",
      "default": 50
    },
    "station_dwell_bottleneck_threshold_pct": {
      "type": "number",
      "default": 25,
      "description": "Separate from station_bottleneck_threshold (a raw WIP count) — this is a percentage variance threshold for the dwell-time signal in getStationDwellVariance, so the two units are never mixed under one setting."
    },
    "last_updated_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "setting_group"
  ]
}