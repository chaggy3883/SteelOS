{
  "name": "CloseChecklistItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "close_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["AP", "AR", "Job Cost", "Cash", "Payroll", "Reporting"]
    },
    "task_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["Not Started", "In Progress", "Complete", "N/A"],
      "default": "Not Started"
    },
    "assigned_to": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "company_id",
    "close_id",
    "period",
    "task_name"
  ]
}
