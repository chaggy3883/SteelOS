{
  "name": "Bid",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "bid_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "general_contractor_id": {
      "type": "string"
    },
    "general_contractor_name": {
      "type": "string"
    },
    "job_name": {
      "type": "string"
    },
    "job_location": {
      "type": "string"
    },
    "street": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "tax_enabled": {
      "type": "boolean",
      "default": false
    },
    "job_city": {
      "type": "string"
    },
    "job_state": {
      "type": "string"
    },
    "bid_due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "submitted",
        "won",
        "lost",
        "cancelled",
        "Did_Not_Bid"
      ],
      "default": "draft"
    },
    "bid_total_cost": {
      "type": "number",
      "default": 0
    },
    "bid_quoted_price": {
      "type": "number",
      "default": 0
    },
    "margin_percentage": {
      "type": "number",
      "default": 0
    },
    "estimated_tons": {
      "type": "number",
      "default": 0
    },
    "total_weight_tons": {
      "type": "number",
      "description": "The bid's official estimated tonnage (from the estimator's Full Takeoff / worksheet), used as the comparison baseline for IRONSIGHT's markup-vs-bid variance check. Optional — separate from estimated_tons so a variance check never silently compares against an unset baseline."
    },
    "estimated_man_hours": {
      "type": "number",
      "default": 0
    },
    "shop_efficiency_pct": {
      "type": "number",
      "default": 100
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "joist_deck_tax_rate": {
      "type": "number",
      "default": 0.0675
    },
    "joist_deck_taxable": {
      "type": "boolean",
      "default": false,
      "description": "Joist and deck line items are only taxed when this is explicitly enabled."
    },
    "tax_exempt_certificate_uri": {
      "type": "string",
      "description": "Uploaded tax exemption certificate file reference (base64 data URI), shown when the bid is tax exempt."
    },
    "paint_gallons": {
      "type": "number",
      "default": 0
    },
    "production_duration_days": {
      "type": "number",
      "default": 0
    },
    "scope_summary": {
      "type": "string"
    },
    "structural_geometry_type": {
      "type": "string",
      "enum": [
        "beam_column",
        "truss",
        "frame",
        "misc_metals",
        "stairs_rails",
        "deck_joist",
        "bridge",
        "other"
      ],
      "default": "beam_column"
    },
    "loss_reason": {
      "type": "string",
      "enum": [
        "",
        "price",
        "competitor",
        "schedule",
        "capacity",
        "scope_clarity",
        "relationship",
        "other"
      ]
    },
    "loss_reason_notes": {
      "type": "string"
    },
    "dnb_reason": {
      "type": "string",
      "enum": [
        "",
        "not_enough_time_to_bid",
        "not_enough_time_in_shop",
        "not_in_scope",
        "cannot_meet_requirements",
        "other"
      ]
    },
    "dnb_reason_notes": {
      "type": "string"
    },
    "competitor_name": {
      "type": "string"
    },
    "won_project_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "front_end_review_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_review",
        "approved",
        "flagged"
      ],
      "default": "not_started"
    },
    "inclusions": {
      "type": "string"
    },
    "exclusions": {
      "type": "string"
    },
    "insurance_override": {
      "type": "number"
    },
    "insurance_enabled": {
      "type": "boolean",
      "default": true
    },
    "insurance_general_liability": {
      "type": "number"
    },
    "insurance_umbrella": {
      "type": "number"
    },
    "insurance_professional_liability": {
      "type": "number"
    },
    "bond_override": {
      "type": "number"
    },
    "bond_enabled": {
      "type": "boolean",
      "default": true
    },
    "procore_pay_override": {
      "type": "number"
    },
    "textura_override": {
      "type": "number"
    },
    "leed_level_override": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "estimator_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_server_path": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "bid_number",
    "customer_name",
    "job_name"
  ]
}