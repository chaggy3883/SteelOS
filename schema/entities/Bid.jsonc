{
  "name": "Bid",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "bid_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "general_contractor_id": {
      "type": "string"
    },
    "general_contractor_name": {
      "type": "string"
    },
    "job_name": {
      "type": "string"
    },
    "job_location": {
      "type": "string"
    },
    "street": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "tax_enabled": {
      "type": "boolean",
      "default": false
    },
    "job_city": {
      "type": "string"
    },
    "job_state": {
      "type": "string"
    },
    "bid_due_date": {
      "type": "string",
      "format": "date"
    },
    "bid_submitted_date": {
      "type": "string",
      "format": "date",
      "description": "Set by the 'Bid Submitted' action on BidDetail.jsx — anchors the 21-day follow-up window (see bidPricingHold.js) instead of bid_due_date. Null until the bid has actually gone out."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "submitted",
        "won",
        "lost",
        "cancelled",
        "Did_Not_Bid"
      ],
      "default": "draft"
    },
    "bid_total_cost": {
      "type": "number",
      "default": 0
    },
    "bid_quoted_price": {
      "type": "number",
      "default": 0
    },
    "margin_percentage": {
      "type": "number",
      "default": 0
    },
    "markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "DEFAULT markup % only — pre-fills TakeoffLine.markup_percentage when a line item is first created on the BID Worksheet (TakeoffEngine.jsx). Each line item owns its own markup from that point on; bid_total_cost is rolled up from the sum of each line's own quoted price (total_cost * (1 + its markup_percentage/100)), not from this field directly. The Worksheet displays the resulting dollar-weighted average markup as a read-only summary."
    },
    "drawings_used": {
      "type": "string",
      "description": "Free-text list of drawing revisions/sets referenced for this bid. Entered on the BID Worksheet."
    },
    "addendums": {
      "type": "string",
      "description": "Free-text list of addenda/bulletins incorporated into this bid. Entered on the BID Worksheet."
    },
    "attention_name": {
      "type": "string",
      "description": "Customer-side contact name shown as \"Attention:\" on the proposal PDF's top info block. Entered on the BID Worksheet."
    },
    "specification_sections": {
      "type": "string",
      "description": "Free-text list of spec sections this bid was priced against, shown on the proposal PDF's top info block. Entered on the BID Worksheet."
    },
    "supplied_cut_sheet": {
      "type": "string",
      "description": "Free-text note (or file reference) identifying any cut sheet supplied for this bid, shown on the proposal PDF's top info block. Entered on the BID Worksheet."
    },
    "pricing_basis": {
      "type": "string",
      "enum": ["fob", "erected"],
      "default": "fob",
      "description": "Which pricing-basis label the proposal PDF shows above the total price — 'fob' renders \"F.O.B. Jobsite (Supply Only - Not Erected)\", 'erected' renders \"Fabricated, Delivered, and Installed\". Entered on the BID Worksheet. Distinct from TurnoverMeetingRecord.pricing_basis, which records the same fact at project handoff rather than at bid time."
    },
    "alternates_text": {
      "type": "string",
      "description": "Free-text list of priced alternates for this bid, shown on the proposal PDF's Alternates / Allowances section. Omits the whole section when both this and allowances_text are blank. Entered on the BID Worksheet."
    },
    "allowances_text": {
      "type": "string",
      "description": "Free-text list of allowances carried in this bid, shown on the proposal PDF's Alternates / Allowances section. Omits the whole section when both this and alternates_text are blank. Entered on the BID Worksheet."
    },
    "metal_deck_squares": {
      "type": "number",
      "description": "Metal deck quantity in squares, shown on the proposal PDF's Material Quantity Summary. No takeoff tool computes this (Joist & Deck is priced as a single flat-quote cost category with no quantity breakdown) — entered manually on the BID Worksheet."
    },
    "steel_joist_pieces": {
      "type": "number",
      "description": "Steel joist piece count, shown on the proposal PDF's Material Quantity Summary. No takeoff tool computes this (Joist & Deck is priced as a single flat-quote cost category with no quantity breakdown) — entered manually on the BID Worksheet."
    },
    "steel_joist_tons": {
      "type": "number",
      "description": "Steel joist tonnage, shown on the proposal PDF's Material Quantity Summary. No takeoff tool computes this (Joist & Deck is priced as a single flat-quote cost category with no quantity breakdown) — entered manually on the BID Worksheet."
    },
    "pricing_type": {
      "type": "string",
      "enum": ["fixed_price", "time_and_material"],
      "default": "fixed_price",
      "description": "Selected at bid creation. 'time_and_material' hides the fixed-price takeoff tabs (BID Worksheet, Full Takeoff, Vendor Pricing) and shows the T&M Estimate tab (TmEstimateWorksheet.jsx) instead. Carried onto Project.pricing_type when the bid is won — see createProjectFromWonBid in BidDetail.jsx."
    },
    "tm_markup_percentage": {
      "type": "number",
      "description": "T&M-only markup %, applied to each of the labor/material/subcontractor subtotals on the T&M estimate. Pre-filled from Company.default_tm_markup_percentage but editable per bid. Carried onto Project.tm_markup_percentage when won."
    },
    "is_prevailing_wage": {
      "type": "boolean",
      "default": false,
      "description": "Set on the Base Information section at bid time. Carried onto Project.is_prevailing_wage when the bid is won — see createProjectFromWonBid in BidDetail.jsx."
    },
    "wage_determination_number": {
      "type": "string",
      "description": "Carried onto Project.wage_determination_number when won."
    },
    "prevailing_wage_jurisdiction": {
      "type": "string",
      "description": "Carried onto Project.prevailing_wage_jurisdiction when won."
    },
    "estimated_tons": {
      "type": "number",
      "default": 0
    },
    "total_weight_tons": {
      "type": "number",
      "description": "The bid's official estimated tonnage (from the estimator's Full Takeoff / worksheet), used as the comparison baseline for IRONSIGHT's markup-vs-bid variance check. Optional — separate from estimated_tons so a variance check never silently compares against an unset baseline."
    },
    "estimated_man_hours": {
      "type": "number",
      "default": 0
    },
    "shop_efficiency_pct": {
      "type": "number",
      "default": 100
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "joist_deck_tax_rate": {
      "type": "number",
      "default": 0.0675,
      "description": "Independent tax rate applied only to the joist_deck line item — gated by tax_enabled/tax_exempt, the same single source of truth as every other tax line, not a separate toggle (the old joist_deck_taxable field was removed for exactly this reason: two independently-wired tax toggles, and only one of them actually drove the calculation)."
    },
    "tax_exempt_certificate_uri": {
      "type": "string",
      "description": "Uploaded tax exemption certificate file reference (base64 data URI), shown when the bid is tax exempt."
    },
    "tax_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Derived, not independently editable — always set to !tax_enabled on save (see handleBaseInfoSave in BidDetail.jsx). When true, computeEffectiveTaxRate always returns 0 regardless of jurisdiction/Ohio-fallback/manual tax_rate. Kept as its own field for backward compatibility/reporting since existing code reads it directly (financialAnalytics.js, TakeoffEngine.jsx, print views)."
    },
    "tax_exempt_reason": {
      "type": "string",
      "description": "Free text explaining the tax_exempt flag, e.g. \"Government project\" or \"Resale certificate #1234\". Shown on the proposal in place of a tax rate/amount when tax_exempt is true."
    },
    "tax_rate_source": {
      "type": "string",
      "enum": [
        "jurisdiction_table",
        "ohio_hardcoded_fallback",
        "manual_entry",
        "tax_exempt"
      ],
      "default": "manual_entry",
      "description": "Which calculation path produced tax_rate at the time it was last calculated and saved (TakeoffEngine.jsx's handleSave, or BidDetail.jsx's Base Info save) — snapshotted so it's always clear which of the consolidated tax paths produced this bid's number, and so later admin-side rate changes don't retroactively relabel historical bids."
    },
    "tax_rate_effective_date": {
      "type": "string",
      "format": "date",
      "description": "The effective_date of the TaxRate row used, when tax_rate_source is 'jurisdiction_table'. Null for the other sources."
    },
    "tax_zone_id": {
      "type": "string",
      "description": "FK to the specific TaxRate row used when tax_rate_source is 'jurisdiction_table' — snapshotted at calculation time so this bid stays traceable to the exact jurisdiction row, even after that ZIP's rate is later superseded by a new row."
    },
    "paint_gallons": {
      "type": "number",
      "default": 0
    },
    "production_duration_days": {
      "type": "number",
      "default": 0
    },
    "scope_summary": {
      "type": "string"
    },
    "loss_reason": {
      "type": "string",
      "enum": [
        "",
        "price",
        "competitor",
        "schedule",
        "capacity",
        "scope_clarity",
        "relationship",
        "other"
      ]
    },
    "loss_reason_notes": {
      "type": "string"
    },
    "dnb_reason": {
      "type": "string",
      "enum": [
        "",
        "not_enough_time_to_bid",
        "not_enough_time_in_shop",
        "not_in_scope",
        "cannot_meet_requirements",
        "other"
      ]
    },
    "dnb_reason_notes": {
      "type": "string"
    },
    "meeting_follow_up_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Set by 'Remove from list' in Meeting Mode's Estimating Updates section (src/components/meeting-mode/sections/EstimatingUpdatesSection.jsx) — only removes this bid from that recurring section's 21+ day follow-up surfacing. Never touches status (won/lost/Did_Not_Bid)."
    },
    "meeting_follow_up_dismissed_by": {
      "type": "string",
      "description": "User.id who dismissed it, set alongside meeting_follow_up_dismissed."
    },
    "meeting_follow_up_dismissed_at": {
      "type": "string",
      "format": "date-time"
    },
    "competitor_name": {
      "type": "string"
    },
    "won_project_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "front_end_review_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_review",
        "approved",
        "flagged"
      ],
      "default": "not_started"
    },
    "inclusions": {
      "type": "string"
    },
    "exclusions": {
      "type": "string"
    },
    "insurance_override": {
      "type": "number"
    },
    "insurance_enabled": {
      "type": "boolean",
      "default": true
    },
    "insurance_general_liability": {
      "type": "number"
    },
    "insurance_umbrella": {
      "type": "number"
    },
    "insurance_professional_liability": {
      "type": "number"
    },
    "bond_override": {
      "type": "number",
      "description": "Manual override for the Performance/Payment Bond estimate — used in place of the tiered-rate formula (see calculateBondAmount in src/lib/bidWorksheetCalc.js) when a real bond quote comes in different. Null/absent means use the calculated value."
    },
    "bond_enabled": {
      "type": "boolean",
      "default": true
    },
    "procore_pay_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When on, a 0.2% payment-processing fee (plus tax on that fee) is auto-calculated from the proposal total — see calculatePaymentPlatformFee in src/lib/bidWorksheetCalc.js. No manual dollar entry."
    },
    "textura_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Same 0.2% auto-calculated payment-processing fee as procore_pay_enabled, for bids using Textura instead of Procore Pay."
    },
    "leed_level_override": {
      "type": "string",
      "enum": [
        "Certified",
        "Silver",
        "Gold",
        "Platinum",
        "Government"
      ],
      "description": "Maps to a fixed hour allocation at $50/hr (30/50/80/120/140 hours respectively — see LEED_SURCHARGE_LEVELS in src/lib/bidWorksheetCalc.js), added to the total price. Null/absent means not a LEED or government job — no surcharge line. Must stay 'Government' (not 'Government Job', which is display-only) to match bidRecapMapping.js's LEED_TIERS."
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "estimator_id": {
      "type": "string"
    },
    "salesman_id": {
      "type": "string",
      "description": "FK to employees — who sold this bid, distinct from estimator_id (who priced it). Carried onto Project.salesman_id when the bid is won."
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_server_path": {
      "type": "string",
      "default": ""
    },
    "delivery_distance_miles": {
      "type": "number",
      "description": "One-way mileage from the company address to this bid's jobsite address, from googleMapsService.calculateDistance. Null until calculated."
    },
    "delivery_trip_count": {
      "type": "number",
      "default": 1
    },
    "delivery_cost_per_trip": {
      "type": "number",
      "description": "Resolved cost per trip — either the matched DeliveryPricingTier.cost_per_trip, or a manual entry when delivery_cost_manual_entry is true."
    },
    "delivery_cost_manual_entry": {
      "type": "boolean",
      "default": false,
      "description": "True when delivery_cost_per_trip was typed manually (mileage exceeds every DeliveryPricingTier band, or mileage could not be calculated) rather than resolved from a tier."
    },
    "delivery_cost_code": {
      "type": "string",
      "description": "Selected CostCode.code_name for the delivery line item, e.g. \"DELIVERY\"."
    },
    "delivery_total_cost": {
      "type": "number",
      "description": "delivery_cost_per_trip * delivery_trip_count, rolled into bid_total_cost."
    },
    "delivery_job_cost_entry_id": {
      "type": "string",
      "description": "Id of the JobCostLedgerEntry posted for this bid's delivery cost, once a project exists (project_id or won_project_id) — re-saves update this entry instead of duplicating it."
    }
  },
  "required": [
    "bid_number",
    "customer_name",
    "job_name"
  ]
}