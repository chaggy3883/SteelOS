{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "commercial",
        "industrial",
        "bridge",
        "miscellaneous",
        "residential",
        "government"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "estimating",
        "awarded",
        "engineering",
        "fabrication",
        "erection",
        "complete",
        "cancelled"
      ],
      "default": "estimating"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "project_manager_id": {
      "type": "string"
    },
    "estimator_id": {
      "type": "string"
    },
    "salesman_id": {
      "type": "string",
      "description": "FK to employees — carried over from Bid.salesman_id when a won bid auto-creates its project (see createProjectFromWonBid in BidDetail.jsx). Drives ProjectCommission via src/lib/commissionEngine.js."
    },
    "contract_value": {
      "type": "number"
    },
    "original_contract": {
      "type": "number",
      "default": 0
    },
    "change_orders_to_date": {
      "type": "number",
      "default": 0
    },
    "billed_to_date": {
      "type": "number",
      "default": 0
    },
    "retainage": {
      "type": "number",
      "default": 0
    },
    "net_billings": {
      "type": "number",
      "default": 0
    },
    "cash_received": {
      "type": "number",
      "default": 0
    },
    "left_to_bill": {
      "type": "number",
      "default": 0
    },
    "estimated_tons": {
      "type": "number"
    },
    "bid_date": {
      "type": "string",
      "format": "date"
    },
    "award_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "health_score": {
      "type": "number",
      "default": 100
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "contract_risk": {
      "type": "number",
      "default": 0
    },
    "schedule_risk": {
      "type": "number",
      "default": 0
    },
    "quality_risk": {
      "type": "number",
      "default": 0
    },
    "financial_risk": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_server_path": {
      "type": "string",
      "default": ""
    },
    "project_phasing_mode": {
      "type": "string",
      "enum": ["sequence", "area"],
      "default": "sequence",
      "description": "How this project's PieceMark.phase values are organized — 'sequence' for numbered erection order, 'area' for named zones."
    },
    "manpower_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trade": { "type": "string" },
          "headcount_needed": { "type": "number", "default": 0 }
        }
      },
      "default": [],
      "description": "Current staffing needs by trade for this job, set by a PM (e.g. from Meeting Mode's Manpower section) — compared against active CrewAssignment rows for the same trade to show a staffing gap. Not period-boxed; represents the job's present need, not a history."
    },
    "required_certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "employee_certifications.cert_type values this job requires of anyone assigned to it — used by Meeting Mode's Manpower section to warn when assigning someone without a matching valid certification. Empty by default; no job has certification requirements tracked until a PM sets them."
    },
    "is_prevailing_wage": {
      "type": "boolean",
      "default": false
    },
    "wage_determination_number": {
      "type": "string"
    },
    "prevailing_wage_jurisdiction": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "project_number"
  ],
  "name": "Project"
}