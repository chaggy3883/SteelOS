{
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "commercial",
        "industrial",
        "bridge",
        "miscellaneous",
        "residential",
        "government"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "estimating",
        "awarded",
        "engineering",
        "fabrication",
        "erection",
        "complete",
        "cancelled"
      ],
      "default": "estimating"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "project_manager_id": {
      "type": "string"
    },
    "estimator_id": {
      "type": "string"
    },
    "salesman_id": {
      "type": "string",
      "description": "FK to employees — carried over from Bid.salesman_id when a won bid auto-creates its project (see createProjectFromWonBid in BidDetail.jsx). Drives ProjectCommission via src/lib/commissionEngine.js."
    },
    "contract_value": {
      "type": "number",
      "description": "DERIVED = original_contract + change_orders_to_date, recomputed by syncProjectChangeOrderMetrics (src/lib/changeOrderMetrics.js) whenever either changes — never manually edited. Set once at project creation (ProjectNew.jsx / createProjectFromWonBid in BidDetail.jsx) equal to original_contract when there are no change orders yet."
    },
    "original_contract": {
      "type": "number",
      "default": 0,
      "description": "Base contract value at signing — set once at project creation, immutable afterward. Change orders never modify this field; they roll into change_orders_to_date instead."
    },
    "change_orders_to_date": {
      "type": "number",
      "default": 0,
      "description": "Running total of this project's APPROVED change_orders.cost_impact — maintained only by syncProjectChangeOrderMetrics (src/lib/changeOrderMetrics.js), which recomputes it from scratch on every change order create/status update so a later rejection/void of a previously-approved CO correctly reverses out. Never edited directly."
    },
    "billed_to_date": {
      "type": "number",
      "default": 0
    },
    "retainage": {
      "type": "number",
      "default": 0
    },
    "net_billings": {
      "type": "number",
      "default": 0
    },
    "cash_received": {
      "type": "number",
      "default": 0
    },
    "left_to_bill": {
      "type": "number",
      "default": 0
    },
    "total_invoiced_to_date": {
      "type": "number",
      "default": 0,
      "description": "Rollup of amounts billed to the customer. Has the same staleness risk as any manually-synced rollup — for WIP over/underbilling math, wipCalculations.js sums real InvoiceReceivable.gross_amount records instead of trusting this field."
    },
    "remaining_project_balance": {
      "type": "number",
      "default": 0,
      "description": "DERIVED = contract_value - total_invoiced_to_date, recomputed alongside contract_value by syncProjectChangeOrderMetrics. Never manually edited."
    },
    "estimated_tons": {
      "type": "number"
    },
    "bid_date": {
      "type": "string",
      "format": "date"
    },
    "award_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "health_score": {
      "type": "number",
      "default": 100
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "contract_risk": {
      "type": "number",
      "default": 0
    },
    "schedule_risk": {
      "type": "number",
      "default": 0
    },
    "quality_risk": {
      "type": "number",
      "default": 0
    },
    "financial_risk": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_server_path": {
      "type": "string",
      "default": ""
    },
    "project_phasing_mode": {
      "type": "string",
      "enum": ["sequence", "area"],
      "default": "sequence",
      "description": "How this project's PieceMark.phase values are organized — 'sequence' for numbered erection order, 'area' for named zones."
    },
    "manpower_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trade": { "type": "string" },
          "headcount_needed": { "type": "number", "default": 0 }
        }
      },
      "default": [],
      "description": "Current staffing needs by trade for this job, set by a PM (e.g. from Meeting Mode's Manpower section) — compared against active CrewAssignment rows for the same trade to show a staffing gap. Not period-boxed; represents the job's present need, not a history."
    },
    "required_certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "employee_certifications.cert_type values this job requires of anyone assigned to it — used by Meeting Mode's Manpower section to warn when assigning someone without a matching valid certification. Empty by default; no job has certification requirements tracked until a PM sets them."
    },
    "pricing_type": {
      "type": "string",
      "enum": ["fixed_price", "time_and_material"],
      "default": "fixed_price",
      "description": "Carried from Bid.pricing_type when this project is created from a won bid (createProjectFromWonBid in BidDetail.jsx). Gates the T&M Tracking tab on ProjectDetail.jsx and the T&M invoicing mode in InvoiceReceivableDetailModal.jsx."
    },
    "tm_markup_percentage": {
      "type": "number",
      "description": "Carried from Bid.tm_markup_percentage. Applied to actual labor/material/subcontractor totals when generating a T&M invoice."
    },
    "is_prevailing_wage": {
      "type": "boolean",
      "default": false,
      "description": "Carried from Bid.is_prevailing_wage when this project is created from a won bid (createProjectFromWonBid in BidDetail.jsx) — not directly editable on the project."
    },
    "wage_determination_number": {
      "type": "string",
      "description": "Carried from Bid.wage_determination_number when won."
    },
    "prevailing_wage_jurisdiction": {
      "type": "string",
      "description": "Carried from Bid.prevailing_wage_jurisdiction when won."
    },
    "scope_review_general_notes": {
      "type": "string",
      "description": "Freeform notes on the Scope Review tab (Project Handoff) not tied to any specific ScopeReviewQuestion row. Edited alongside the question list in ScopeReviewPanel.jsx."
    }
  },
  "required": [
    "name",
    "project_number"
  ],
  "name": "Project"
}