{
  "name": "BidReviewReport",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "bid_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "skill_name": {
      "type": "string"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "report_content": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "bid_id",
    "skill_id"
  ]
}
