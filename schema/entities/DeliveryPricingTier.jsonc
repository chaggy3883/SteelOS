{
  "name": "DeliveryPricingTier",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "min_miles": {
      "type": "number",
      "description": "Inclusive lower bound of the mileage band. 0 means \"no minimum\" (displayed as \"< max_miles\")."
    },
    "max_miles": {
      "type": "number"
    },
    "cost_per_trip": {
      "type": "number"
    }
  },
  "required": [
    "min_miles",
    "max_miles",
    "cost_per_trip"
  ]
}
