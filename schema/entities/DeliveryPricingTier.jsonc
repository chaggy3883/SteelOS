{
  "name": "DeliveryPricingTier",
  "type": "object",
  "description": "Flat delivery cost per trip, banded by one-way mileage from the company address to the jobsite. Admin-managed in the Delivery Pricing Tiers section of /admin/bid-worksheet-rates (CostCategoryRatesAdmin.jsx; the old /admin/delivery-pricing URL redirects there). Read by TakeoffEngine.jsx's freight mileage calculator to price the Jobsite Freight (Material Delivery) line.",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "min_miles": {
      "type": "number",
      "description": "Inclusive lower bound of the mileage band. 0 means \"no minimum\" (displayed as \"< max_miles\")."
    },
    "max_miles": {
      "type": "number"
    },
    "cost_per_trip": {
      "type": "number"
    }
  },
  "required": [
    "min_miles",
    "max_miles",
    "cost_per_trip"
  ]
}
