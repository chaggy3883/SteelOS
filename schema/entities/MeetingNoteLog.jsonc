{
  "name": "MeetingNoteLog",
  "type": "object",
  "description": "Append-only history of Meeting Mode notes, one new row per save (never overwritten in place) — same discipline as StatusHistoryEntry. For the 'sections' meeting format, the note shown when a meeting/section is reopened is simply the most recent row for a given meeting_id+section, which is what makes last week's notes stay visible until someone types new ones (written/read by src/components/meeting-mode/MeetingSectionNotesPanel.jsx). For the 'project_notes' meeting format, the same append-only shape is reused keyed by project_id/bid_id instead — the most recent row for a given project_id (or bid_id) is what stays visible until edited, regardless of which Meeting instance saved it (written/read by src/components/meeting-mode/ProjectBidNotesSession.jsx).",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "meeting_id": {
      "type": "string",
      "description": "FK to Meeting.id — which specific meeting occurrence this note was saved during."
    },
    "meeting_type": {
      "type": "string",
      "description": "Denormalized snapshot of the parent Meeting's *name* at the time this note was saved, so a later rename doesn't rewrite historical context. Field name kept for continuity even though meetings no longer have a fixed type."
    },
    "section": {
      "type": "string",
      "description": "Section key (see src/lib/meetingModeSections.js) this note was captured under, e.g. 'project_status', 'estimating_updates'. Fixed to the literal string 'project_notes' for rows saved from the project_notes meeting format (see project_id/bid_id below), since that format has no real sections."
    },
    "project_id": {
      "type": "string",
      "description": "FK to Project.id — only set on a 'project_notes'-format row logged against a Project. Null/absent for every other row (including bid_id-keyed project_notes rows and all 'sections'-format rows)."
    },
    "bid_id": {
      "type": "string",
      "description": "FK to Bid.id — only set on a 'project_notes'-format row logged against a Bid instead of a Project. Null/absent otherwise."
    },
    "note_text": {
      "type": "string"
    },
    "saved_by": {
      "type": "string",
      "description": "User.id of whoever was logged in when this note was saved."
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "meeting_id",
    "section",
    "note_text",
    "saved_by",
    "saved_at"
  ]
}
