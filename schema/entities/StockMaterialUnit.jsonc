{
  "name": "StockMaterialUnit",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "material_optimization_run_id": {
      "type": "string",
      "description": "FK to the MaterialOptimizationRun this stock bar belongs to."
    },
    "unit_number": {
      "type": "string",
      "description": "Human-readable label, e.g. \"Stock #7\". Numbered 1..quantity_of_stock_required WITHIN its own run (matching that run's pieces_assigned.position_in_stock), not a company-wide running count — two different runs can each have a \"Stock #1\"."
    },
    "purchase_order_line_id": {
      "type": "string",
      "description": "FK to purchase_order_lines — set to the single line covering this run's whole stock_length_used quantity (every unit in a run shares the same line id), when materialOptimizationCommit.js was able to auto-generate a PO line (a preferred vendor was configured on the matching StockLengthOption). Blank until then, and permanently blank if no vendor was ever configured."
    },
    "received_date": {
      "type": "string",
      "format": "date-time",
      "description": "Set when this specific physical bar is received. Blank until then."
    },
    "heat_number": {
      "type": "string",
      "description": "Mill certification / MTR heat number for this specific bar — null through commit, since Stage 6-7 never wired a receiving UI. Stage 10 adds the first write path: an editable field on StockMaterialUnitDetailModal.jsx, which also fires src/lib/heatPropagation.js to push this value onto every PieceMark cut from this bar (see MaterialOptimizationRun.pieces_assigned)."
    },
    "status": {
      "type": "string",
      "enum": ["planned", "ordered", "received", "consumed"],
      "default": "planned",
      "description": "planned: created at commit, no PO line (no vendor configured yet). ordered: a purchase_order_line_id was assigned at commit time. received/consumed: later lifecycle states — 'received' is set alongside heat_number by StockMaterialUnitDetailModal.jsx's Stage 10 edit action; 'consumed' is not yet written by any path."
    },
    "remnant_length_in": {
      "type": "number",
      "default": 0,
      "description": "Stage 10: this specific bar's own leftover length (inches) after its assigned cuts — computed at commit time from the same plan.bins data pieces_assigned came from. Distinct from MaterialOptimizationRun.remnant_length_in, which is the run-wide total across every bar in the run."
    },
    "remnant_logged": {
      "type": "boolean",
      "default": false,
      "description": "Stage 10: true once a remnant_inventory record has been created from this bar's leftover (see remnant_inventory.source_stock_material_unit_id) — prevents logging the same leftover twice. Logging requires heat_number to already be set, since a remnant carries its source bar's heat forward."
    }
  },
  "required": [
    "material_optimization_run_id",
    "unit_number"
  ]
}
