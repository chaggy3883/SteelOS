{
  "name": "User",
  "type": "object",
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["user"],
      "description": "The role(s) of the user in the app (built-in or custom role names)"
    },
    "permissions": {
      "type": "object"
    },
    "password": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company_id": {
      "type": "string",
      "description": "The tenant this user belongs to. Platform-level super_admin users have no home tenant and leave this blank."
    },
    "employee_id": {
      "type": "string",
      "description": "Optional link to an employees row, for a portal (email/password) account that belongs to the same person as a timeclock employee record. When set, login is also gated on that employees row's active status (see isEmployeeActive in employeeAuth.js) — terminating the employee revokes this portal login too. Blank for accounts with no matching employees row (e.g. a pure office/admin account, or a customer/vendor login)."
    },
    "permission_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "page_layouts_json": {
      "type": "object",
      "description": "Per-user, per-page widget layout dictionary — keys are page paths (e.g. 'dashboard'), values are that page's saved widget array. Only pages with a customizable widget grid ever populate a key here."
    }
  },
  "required": [
    "roles"
  ]
}