{
  "name": "piece_production_logs",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "piece_mark": {
      "type": "string"
    },
    "material_profile_type": {
      "type": "string",
      "enum": [
        "Wide_Flange_Beam",
        "Moment_Column",
        "Angle",
        "Channel",
        "Plate",
        "HSS",
        "Other"
      ],
      "default": "Other"
    },
    "target_minutes": {
      "type": "number",
      "description": "Positive minutes, or null if the employee left it blank at punch-in. Never 0 as a sentinel for 'no target' — 0 would be silently summed into efficiency/variance math as if it were a real target. Written/read only through shopOpsMetrics.js's normalizeTargetMinutes so a blank input, garbage input, and an unset record are all represented the same way (null) everywhere."
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_minutes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "In_Progress",
        "Complete"
      ],
      "default": "In_Progress"
    }
  },
  "required": [
    "employee_id",
    "piece_mark",
    "start_time"
  ]
}
