{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company_code": {
      "type": "string"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "structural_steel_fabricator",
        "steel_erector",
        "bridge_fabricator",
        "miscellaneous_metals",
        "industrial_steel",
        "commercial_steel",
        "detailing_company",
        "steel_service_center"
      ]
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "aisc_certification": {
      "type": "string"
    },
    "aisc_expiry": {
      "type": "string",
      "format": "date"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "enterprise",
        "SteelOS_Fab",
        "SteelOS_Erect",
        "Enterprise_Connect",
        "SteelOS_ShopFab"
      ],
      "default": "starter"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "settings": {
      "type": "object"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "Active",
        "Past_Due",
        "Inactive"
      ],
      "default": "Active"
    },
    "brand_color_hex": {
      "type": "string",
      "default": "#2563eb"
    },
    "logo_scale_pct": {
      "type": "integer",
      "default": 100
    },
    "ai_provider": {
      "type": "string",
      "enum": ["local", "claude", "openai"],
      "default": "local"
    },
    "tenant_local_url": {
      "type": "string",
      "default": "http://localhost:8080/v1"
    },
    "enabled_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Module entitlement allowlist, e.g. [\"equipment\",\"payroll\",\"ironsight\"]. Empty or missing means every module is on — see src/lib/moduleEntitlement.js's hasModule(), the only reader of this field. Editable only from Super Admin Dashboard."
    },
    "meeting_mode_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Admin-configured default set of Meeting Mode section keys (see src/lib/meetingModeSections.js), set from Admin > Meeting Mode. Pre-fills the section checklist when creating a new meeting; always re-filtered against getAvailableSections(company) before use, never trusted blindly if the company's pack changes later."
    },
    "default_tm_markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "Company-wide default markup % pre-filled onto a new T&M bid's tm_markup_percentage — editable per bid from there. Set from Admin > Company Settings."
    },
    "default_issued_asset_kit": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["Badge", "Keys", "Laptop", "Phone"],
      "description": "Standard equipment kit auto-issued as issued_assets rows to every new employee on hire — see provisionDefaultIssuedAssets in src/lib/issuedAssetsApi.js. Empty/missing falls back to the same four-item default (DEFAULT_KIT_FALLBACK). Editable from Admin > Company Settings."
    },
    "turnover_meeting_standard_attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Company-wide standard list of required attendee names/roles for the Turnover / Contract Review meeting (Project Handoff tab). Pre-populates TurnoverMeetingRecord.required_attendees when a project's record is first created; editable per project from there without affecting this company-wide list. Editable from Admin > Turnover Meeting."
    },
    "clarifications_text": {
      "type": "string",
      "description": "Short, plain-text \"Clarifications\" blurb rendered on every customer-facing proposal PDF between Inclusions/Exclusions and the signature block — see bidProposalPdfLayout.js's drawClarifications(). Distinct from CompanyProposalTerms (the large, multi-page uploaded legal terms document appended after the signature block). Empty/missing omits the section entirely rather than showing an empty header. Editable from Settings > Proposal Terms."
    },
    "additional_notes_text": {
      "type": "string",
      "description": "Short, plain-text \"Additional Notes\" blurb rendered on the proposal PDF as its own section immediately after Clarifications — distinct field, distinct heading, same empty-omits-the-section convention as clarifications_text. Editable from Settings > Proposal Terms."
    },
    "aisc_certified": {
      "type": "boolean",
      "default": false,
      "description": "Whether this company is an AISC Certified Fabricator. Gates rendering of the AISC badge in the proposal PDF header — not every company using SteelOS holds this certification. Editable from Settings > Company."
    },
    "aisc_badge_url": {
      "type": "string",
      "description": "Image URL for the AISC Certified Fabricator badge graphic shown in the proposal PDF header, next to the company logo. Only rendered when aisc_certified is true and this is set. Editable from Settings > Company."
    },
    "proposal_validity_days": {
      "type": "number",
      "default": 7,
      "description": "How many days after generation a customer-facing proposal PDF remains valid — drives the \"Proposal Expires\" date shown next to the generation date on the proposal, computed at render time (see bidProposalPdfLayout.js). Matches the \"Time Limit of Proposal\" language in Article 1.2.3 of the standard terms. Editable from Settings > Company."
    },
    "terms_last_updated_date": {
      "type": "string",
      "format": "date",
      "description": "Date shown in the per-page proposal PDF footer (\"Last Updated [date]\"), alongside the buyer-initials line — tracks when this company's CompanyProposalTerms content was last revised. Editable from Settings > Company."
    }
  },
  "required": [
    "name",
    "company_type"
  ],
  "name": "Company"
}