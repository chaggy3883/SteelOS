{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company_code": {
      "type": "string"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "structural_steel_fabricator",
        "steel_erector",
        "bridge_fabricator",
        "miscellaneous_metals",
        "industrial_steel",
        "commercial_steel",
        "detailing_company",
        "steel_service_center"
      ]
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "aisc_certification": {
      "type": "string"
    },
    "aisc_expiry": {
      "type": "string",
      "format": "date"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "enterprise",
        "SteelOS_Fab",
        "SteelOS_Erect",
        "Enterprise_Connect"
      ],
      "default": "starter"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "settings": {
      "type": "object"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "Active",
        "Past_Due",
        "Inactive"
      ],
      "default": "Active"
    },
    "brand_color_hex": {
      "type": "string",
      "default": "#2563eb"
    },
    "logo_scale_pct": {
      "type": "integer",
      "default": 100
    },
    "ai_provider": {
      "type": "string",
      "enum": ["local", "claude", "openai"],
      "default": "local"
    },
    "tenant_local_url": {
      "type": "string",
      "default": "http://localhost:8080/v1"
    },
    "enabled_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Module entitlement allowlist, e.g. [\"equipment\",\"payroll\",\"ironsight\"]. Empty or missing means every module is on — see src/lib/moduleEntitlement.js's hasModule(), the only reader of this field. Editable only from Super Admin Dashboard."
    },
    "default_issued_asset_kit": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["Badge", "Keys", "Laptop", "Phone"],
      "description": "Standard equipment kit auto-issued as issued_assets rows to every new employee on hire — see provisionDefaultIssuedAssets in src/lib/issuedAssetsApi.js. Empty/missing falls back to the same four-item default (DEFAULT_KIT_FALLBACK). Editable from Admin > Company Settings."
    }
  },
  "required": [
    "name",
    "company_type"
  ],
  "name": "Company"
}