{
  "name": "PayrollLine",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "payroll_run_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "pay_type_snapshot": {
      "type": "string",
      "description": "employee's EmployeePayRate.pay_type at the time this line was generated, so a later rate change doesn't rewrite history — same convention as PayrollRegisterLine.pay_type_snapshot."
    },
    "regular_hours": {
      "type": "number",
      "default": 0
    },
    "ot_hours": {
      "type": "number",
      "default": 0
    },
    "double_time_hours": {
      "type": "number",
      "default": 0
    },
    "pto_payout_hours": {
      "type": "number",
      "default": 0,
      "description": "Hours of unused PTO/Sick/Bereavement cashed out on a final_check PayrollRun (see processTerminationSettlement in src/lib/ptoEngine.js). Deliberately separate from regular_hours — even though the same final_check line's regular_hours/ot_hours/double_time_hours may carry real unpaid wages for the same termination, this field alone has no backing TimeEntry/JobLaborAllocation, and must never be included in job-cost or certified-payroll hours-worked totals."
    },
    "pto_payout_amount": {
      "type": "number",
      "default": 0,
      "description": "Dollar amount of the pto_payout_hours cash-out, included in gross_pay so it's taxed like any other gross wages."
    },
    "gross_pay": {
      "type": "number",
      "default": 0
    },
    "deductions_total": {
      "type": "number",
      "default": 0,
      "description": "Itemized per deduction type on PayrollLineDeduction (one row per payroll_line_id) — this field is the sum. Lines created before itemized tracking shipped have no PayrollLineDeduction rows; this total is still accurate, it just can't be broken down further."
    },
    "tax_total": {
      "type": "number",
      "default": 0,
      "description": "Employee-side withholding only. Employer-paid taxes are tracked separately per employee on EmployerTax. Itemized per tax type on PayrollLineTax (one row per payroll_line_id) — this field is the sum. Lines created before itemized tracking shipped have no PayrollLineTax rows; this total is still accurate, it just can't be broken down further."
    },
    "net_pay": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "payroll_run_id",
    "employee_id"
  ]
}
