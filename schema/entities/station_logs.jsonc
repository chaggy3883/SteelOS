{
  "name": "station_logs",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "piece_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "station_id": {
      "type": "number",
      "description": "Ids 1-6 are the original stations; a company can add more (7+) in Admin > Shop Stations & Routes — see SystemSetting.shop_stations. Names resolve via stationName() in src/lib/shopStations.js. A row with status Complete is what the route skipped-step check (src/lib/shopRoutes.js) counts as \"been through this station\"."
    },
    "status": {
      "type": "string",
      "enum": [
        "In_Progress",
        "Paused",
        "Complete"
      ],
      "default": "In_Progress"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_minutes": {
      "type": "number",
      "default": 0
    },
    "auto_paused": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "piece_id",
    "station_id",
    "status"
  ]
}
