{
  "name": "VendorBill",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "po_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "gross_amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": ["Pending_Match", "Approved", "Flagged_Review", "Paid"],
      "default": "Pending_Match",
      "description": "'Paid' is set once db.entities.Payment rows applied against this bill (src/lib/paymentEngine.js) cover gross_amount in full — see 'Record Payment' in Accounting.jsx's Vendor Bills tab / VendorBillDetailModal. A bill can only reach 'Paid' from 'Approved'."
    },
    "variance_pct": {
      "type": "number",
      "default": 0
    },
    "conditional_waiver_signed": {
      "type": "boolean",
      "default": false
    },
    "unconditional_waiver_received": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "vendor_id",
    "po_id",
    "gross_amount"
  ]
}
