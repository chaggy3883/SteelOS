{
  "name": "UserDashboardConfig",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "layout": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "i": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "enum": ["1x1", "2x2", "3x2"],
            "default": "1x1"
          }
        }
      }
    },
    "is_customized": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id"
  ]
}