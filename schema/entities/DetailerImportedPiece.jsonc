{
  "name": "DetailerImportedPiece",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Copied from the parent DetailerImportBatch at parse time, for direct filtering without joining through batch_id."
    },
    "batch_id": {
      "type": "string",
      "description": "FK to the DetailerImportBatch this row was staged from."
    },
    "file_id": {
      "type": "string",
      "description": "FK to the specific entry in DetailerImportBatch.uploaded_files this row came from — lets a single file be re-parsed (its old rows deleted and replaced) without touching other files in the same batch."
    },
    "piece_mark": {
      "type": "string"
    },
    "assembly": {
      "type": "string"
    },
    "material_profile": {
      "type": "string",
      "description": "Shape/size designation as reported by the detailer (e.g. \"W12x26\"). Free text — not validated against the steel_catalog entity."
    },
    "material_grade": {
      "type": "string"
    },
    "finished_length": {
      "type": "string",
      "description": "Kept as the raw string the detailer reported (e.g. \"32'-4 1/2\\\"\"), not parsed into decimal feet — same precedent as pieces.dimensions. Maps onto PieceMark.finished_length on promotion."
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "weight": {
      "type": "number",
      "description": "Per-piece weight in pounds, when the source file provides one. Blank (not zero) when the column/field was absent, since KISS detail lines don't always carry a weight."
    },
    "drawing_number": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "raw_row_data": {
      "type": "object",
      "description": "The original row exactly as parsed — CSV: {header: cell value} keyed by the file's own column headers; KSS: {kiss field name: raw value} keyed by the KISS detail-line field template. Kept for traceability back to the source file regardless of how the canonical fields above were interpreted."
    },
    "validation_status": {
      "type": "string",
      "enum": ["valid", "warning", "error"],
      "default": "valid",
      "description": "'error' rows are excluded from commit (missing/duplicate piece mark, non-numeric quantity/weight); 'warning' rows commit normally but are flagged for review (missing material profile/grade/finished length, no matching steel_catalog shape). Set at parse time ('valid'/'error' only) and recomputed batch-wide by validateBatchRows (src/lib/detailerImportValidation.js) when the review screen opens, which is also where 'warning' first appears and where duplicate-within-batch detection happens."
    },
    "validation_errors": {
      "type": "array",
      "description": "Human-readable reasons validation_status is 'error'. Empty otherwise."
    },
    "validation_warnings": {
      "type": "array",
      "description": "Human-readable non-blocking review notes (set only by the batch-wide review pass, never at parse time). Empty when validation_status is 'valid' or 'error'."
    },
    "committed": {
      "type": "boolean",
      "default": false,
      "description": "True once this row has been promoted onto a PieceMark via the batch commit action. Committing is idempotent/incremental — re-running commit on a batch skips rows already committed."
    },
    "piece_mark_id": {
      "type": "string",
      "description": "FK to the PieceMark record this row was committed onto (created or matched-and-updated). Blank until committed."
    }
  },
  "required": [
    "batch_id",
    "piece_mark"
  ]
}
