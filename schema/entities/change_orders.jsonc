{
  "name": "change_orders",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "change_order_id": {
      "type": "string",
      "description": "Human-readable CO number, e.g. 'CO-001' — the existing per-project id used throughout ProjectManagement.jsx."
    },
    "co_sequence_number": {
      "type": "number",
      "description": "Numeric sequence position of this CO on its project (1, 2, 3...), for sorting/display in the cross-project Change Order Hub."
    },
    "description": {
      "type": "string"
    },
    "cost_impact": {
      "type": "number",
      "default": 0,
      "description": "Dollar contract-value impact — the authoritative field ProjectManagement.jsx's revised-contract-value rollup reads."
    },
    "estimated_cost_impact": {
      "type": "number",
      "default": 0,
      "description": "Estimator/PM's projection of what this change order will actually cost to execute (labor + material + subcontractor), entered manually when the CO is priced. Distinct from cost_impact, which is the contract/billing side."
    },
    "margin_impact": {
      "type": "number",
      "default": 0,
      "description": "Derived — cost_impact minus estimated_cost_impact. Recomputed whenever either changes; never manually edited."
    },
    "schedule_impact": {
      "type": "number",
      "default": 0,
      "description": "Schedule impact in days."
    },
    "added_tonnage_weight_lbs": {
      "type": "number",
      "default": 0
    },
    "added_labor_hours": {
      "type": "number",
      "default": 0,
      "description": "Additional shop/field labor hours introduced by this change order."
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "Submitted to GC", "Approved", "Rejected", "Void"],
      "default": "Draft"
    },
    "date_submitted": {
      "type": "string",
      "format": "date"
    },
    "attachment_path": {
      "type": "string"
    },
    "received_from_customer": {
      "type": "boolean",
      "default": false,
      "description": "Set when a salesman marks this CO as received from the customer (Change Order Intake) — triggers a notification to PM and Estimating (see src/lib/salesNotifications.js)."
    }
  },
  "required": [
    "project_id",
    "change_order_id"
  ]
}
