{
  "name": "candidate_profiles",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "position_applied": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Applied",
        "Interviewing",
        "Offer_Extended",
        "Hired",
        "Rejected"
      ],
      "default": "Applied"
    },
    "applied_date": {
      "type": "string",
      "format": "date"
    },
    "hired_employee_id": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "description": "Set by hireCandidate() (src/lib/employeesApi.js) when status flips to Hired — the date HR confirmed in the Hire modal, not necessarily today."
    },
    "rejection_date": {
      "type": "string",
      "format": "date"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Free text — either a picked reason label or custom text from the Reject Candidate modal's 'Other' option."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "candidate_name",
    "position_applied"
  ]
}
