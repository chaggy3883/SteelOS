{
  "name": "loads",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "load_number_id": {
      "type": "string"
    },
    "trailer_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Staged",
        "Partial_Loaded",
        "Loaded",
        "Inspected",
        "In_Transit",
        "Delivered",
        "Field_Issue"
      ],
      "default": "Draft"
    },
    "total_weight_lbs": {
      "type": "number",
      "default": 0
    },
    "carrier_vendor_id": {
      "type": "string",
      "description": "Legacy FK to a Vendor carrier record. New loads use carrier_name (freeform) instead; kept so pre-existing loads and the migrateLegacyShippingLoads path still resolve a carrier."
    },
    "carrier_name": {
      "type": "string",
      "description": "Freeform carrier name entered on the load, optional at creation and required before the BOL can be generated."
    },
    "max_weight_capacity_lbs": {
      "type": "number",
      "default": 45000
    },
    "is_overweight_permit_authorized": {
      "type": "boolean",
      "default": false
    },
    "bol_pdf_data_uri": {
      "type": "string",
      "description": "Generated Bill of Lading PDF (data URI), attached at Call Inspection time and viewed/printed later from the Shipping List."
    },
    "bol_generated_date": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "load_number_id"
  ]
}
