{
  "name": "employee_hiring_documents",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": ["Resume", "Application", "Cover_Letter", "Other"]
    },
    "file_name": {
      "type": "string"
    },
    "blob_key": {
      "type": "string",
      "description": "IndexedDB key in hiringDocumentStore.js, format employee/{employeeId}/{docId}. Rows created here are moved over from candidate_documents by moveCandidateDocumentsToEmployee() (src/lib/hiringDocumentsApi.js) when a candidate is hired — the candidate-side row and blob are deleted once the move succeeds."
    },
    "uploaded_date": {
      "type": "string",
      "format": "date"
    },
    "uploaded_by": {
      "type": "string"
    },
    "note": {
      "type": "string",
      "default": "Uploaded during hiring"
    }
  },
  "required": [
    "employee_id",
    "document_type",
    "file_name",
    "blob_key"
  ]
}
