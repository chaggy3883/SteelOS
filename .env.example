# SteelOS environment variables
# Copy this file to .env.local and fill in values for your environment.
# Never commit .env.local to git — it's already in .gitignore.

# AI proxy backend URL (required for real Claude/OpenAI calls)
# The proxy server receives { prompt, ... } and returns { content, summary }.
# Leave blank to use the local mock (demo/dev only).
VITE_AI_PROXY_URL=

# Local AI server URL (optional — for self-hosted LLM via LM Studio, Ollama, etc.)
# Defaults to http://localhost:8080/v1 if not set.
VITE_LOCAL_AI_URL=

# Local vision model URL (optional — for blueprint shape detection)
# Defaults to http://localhost:8080/v1 if not set.
VITE_LOCAL_VLM_URL=
