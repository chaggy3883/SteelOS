            },
            "actual_hours": {
              "type": "number"
            },
            "variance_pct": {
              "type": "number"
            }
          }
        },
        "drill": {
          "type": "object",
          "properties": {
            "estimated_hours": {
              "type": "number"
            },
            "actual_hours": {
              "type": "number"
            },
            "variance_pct": {
              "type": "number"
            }
          }
        },
        "fab": {
          "type": "object",
          "properties": {
            "estimated_hours": {
              "type": "number"
            },
            "actual_hours": {
              "type": "number"
            },
            "variance_pct": {
              "type": "number"
            }
          }
        },
        "weld": {
          "type": "object",
          "properties": {
            "estimated_hours": {
              "type": "number"
            },
            "actual_hours": {
              "type": "number"
            },
            "variance_pct": {
              "type": "number"
            }
          }
        },
        "paint": {
          "type": "object",
          "properties": {
            "estimated_hours": {
              "type": "number"
            },
            "actual_hours": {
              "type": "number"
            },
            "variance_pct": {
              "type": "number"
            }
          }
