      "type": "string",
      "enum": [
        "not_started",
        "in_fabrication",
        "fabricated",
        "inspected",
        "painted",
        "shipped",
        "erected",
        "rejected"
      ],
      "default": "not_started"
    },
    "fab_start_date": {
      "type": "string",
      "format": "date"
    },
    "fab_complete_date": {
      "type": "string",
      "format": "date"
    },
    "ship_date": {
      "type": "string",
      "format": "date"
    },
    "erect_date": {
      "type": "string",
      "format": "date"
    },
    "barcode": {
      "type": "string"
    },
    "drawing_number": {
      "type": "string"
    },
    "heat_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "warehouse_zone": {
      "type": "string"
    },
    "warehouse_rack": {
      "type": "string"
    }
  },
