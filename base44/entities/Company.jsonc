{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company_code": {
      "type": "string"
    },
    "company_type": {
      "type": "string",
      "enum": [
        "structural_steel_fabricator",
        "steel_erector",
        "bridge_fabricator",
        "miscellaneous_metals",
        "industrial_steel",
        "commercial_steel",
        "detailing_company",
        "steel_service_center"
      ]
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "aisc_certification": {
      "type": "string"
    },
    "aisc_expiry": {
      "type": "string",
      "format": "date"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "enterprise",
        "SteelOS_Fab",
        "SteelOS_Erect",
        "Enterprise_Connect"
      ],
      "default": "starter"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "settings": {
      "type": "object"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "Active",
        "Past_Due",
        "Inactive"
      ],
      "default": "Active"
    },
    "brand_color_hex": {
      "type": "string",
      "default": "#2563eb"
    },
    "logo_scale_pct": {
      "type": "integer",
      "default": 100
    }
  },
  "required": [
    "name",
    "company_type"
  ],
  "name": "Company"
}