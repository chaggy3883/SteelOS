{
  "name": "User",
  "type": "object",
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["user"],
      "description": "The role(s) of the user in the app (built-in or custom role names)"
    },
    "permissions": {
      "type": "object"
    },
    "password": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company_id": {
      "type": "string",
      "description": "The tenant this user belongs to. Platform-level super_admin users have no home tenant and leave this blank."
    },
    "permission_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "roles"
  ]
}