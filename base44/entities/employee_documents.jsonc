{
  "name": "employee_documents",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "document_type_key": {
      "type": "string",
      "enum": ["Drivers_License", "SSN_Card", "Birth_Cert", "Training_Cert"]
    },
    "file_uri": {
      "type": "string"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "employee_id",
    "document_type_key",
    "file_uri"
  ]
}
